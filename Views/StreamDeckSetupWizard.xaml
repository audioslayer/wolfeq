<Window x:Class="WolfEQ.Views.StreamDeckSetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WolfEQ.Controls"
        xmlns:local="clr-namespace:WolfEQ.Views"
        Title="Stream Deck setup"
        Width="552" Height="592"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource WolfTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Same rose tint as the Shortcuts icon in Settings, so the wizard reads as part of that section. -->
        <SolidColorBrush x:Key="WizardAccent" Color="#FF7A90"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:StreamDeckSubtitleVisibilityConverter x:Key="SubtitleVisibility"/>

        <!-- Big numbered circle at the top of each step (AmpUp style). Content is the step number. -->
        <Style x:Key="StepBadge" TargetType="ContentControl">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Ellipse Fill="{DynamicResource WolfGreenBrush}" Opacity="0.10"/>
                            <Ellipse Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.5" Opacity="0.55"/>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource WolfGreenBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StepBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
        </Style>
        <Style x:Key="NavPrimaryButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{DynamicResource WolfGreenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfGreenContrastBrush}"/>
        </Style>

        <!-- A USER slot as a Stream Deck key (same look as Settings › Shortcuts). -->
        <DataTemplate x:Key="KeyTemplate">
            <Button Click="Key_Click" Width="72" Height="72" Margin="5" Cursor="Hand" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Key" CornerRadius="13" Background="#0C1013" BorderBrush="#2A323A" BorderThickness="1.5">
                            <Grid>
                                <Border Height="6" CornerRadius="3" Background="{Binding Glow}" Opacity="0.7" VerticalAlignment="Top" Margin="14,7,14,0">
                                    <Border.Effect><BlurEffect Radius="8"/></Border.Effect>
                                </Border>
                                <Border Height="3" CornerRadius="2" Background="{Binding Glow}" VerticalAlignment="Top" Margin="16,9,16,0"/>
                                <StackPanel VerticalAlignment="Center" Margin="4,8,4,0">
                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource WolfTextBrush}"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="60"
                                               Foreground="{DynamicResource WolfMutedBrush}" Margin="0,2,0,0"
                                               Visibility="{Binding Converter={StaticResource SubtitleVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Key" Property="Background" Value="#141A1F"/>
                                <Setter TargetName="Key" Property="BorderBrush" Value="#3A4550"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Key" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter TargetName="Key" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Key" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter TargetName="Key" Property="Background" Value="#141A1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer frame: rounded border plus a soft shadow so the dialog lifts off the dimmed app. -->
    <Border Margin="16" CornerRadius="{StaticResource RadiusOverlay}" Background="{DynamicResource WolfBgBrush}"
            BorderBrush="{DynamicResource WolfLineSoftBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.6"/>
        </Border.Effect>
        <Grid KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <!-- Title bar (drag to move) -->
            <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="{DynamicResource WolfShellBrush}"
                    BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="16,0,12,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource OverlayCloseButton}" Click="Close_Click" ToolTip="Close (Esc)"
                            AutomationProperties.Name="Close Stream Deck setup" VerticalAlignment="Center" IsTabStop="False">
                        <Path Width="10" Height="10" Data="M 1,1 L 9,9 M 9,1 L 1,9" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="32" Height="32" Margin="0,0,11,0">
                            <Border CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource WizardAccent}" Opacity="0.16"/>
                            <controls:PhosphorIcon IconName="Keyboard" IconSize="16" IconBrush="{StaticResource WizardAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Stream Deck setup" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Steps: exactly one is visible. Top-anchored so the circle and title stay put between steps. -->
            <Grid Grid.Row="1" Margin="36,30,36,16">
                <!-- 1. Pick the slot -->
                <StackPanel x:Name="Step1" VerticalAlignment="Top">
                    <ContentControl Style="{StaticResource StepBadge}" Content="1"/>
                    <TextBlock Text="Pick a USER slot" Style="{StaticResource StepTitle}"/>
                    <TextBlock Text="Each Stream Deck key switches your device to one saved USER slot. Pick the slot for this key." Style="{StaticResource StepBody}"/>
                    <ItemsControl ItemsSource="{Binding StreamDeckKeys}" ItemTemplate="{StaticResource KeyTemplate}" HorizontalAlignment="Center"
                                  Focusable="False" AutomationProperties.Name="USER slots">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" MaxWidth="420"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. Save the shortcut -->
                <StackPanel x:Name="Step2" VerticalAlignment="Top" Visibility="Collapsed">
                    <ContentControl Style="{StaticResource StepBadge}" Content="2"/>
                    <TextBlock Style="{StaticResource StepTitle}" Text="{Binding SelectedStreamDeckKey.Label, StringFormat='Save the {0} shortcut', FallbackValue='Save the shortcut'}"/>
                    <TextBlock Text="WolfEQ saves a small Windows shortcut that switches to this slot. Keep it somewhere safe, like Documents." Style="{StaticResource StepBody}"/>
                    <Button Style="{StaticResource FiioButton}" Command="{Binding SaveStreamDeckShortcutCommand}" HorizontalAlignment="Center" Padding="18,8" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <controls:PhosphorIcon IconName="Folder" IconSize="15" IconBrush="{DynamicResource WolfGreenBrush}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save shortcut..." FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Margin="0,18,0,0" CornerRadius="{StaticResource RadiusCard}" Padding="12,10" Background="{DynamicResource WolfPanel2Brush}"
                            BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="1" HorizontalAlignment="Center" MaxWidth="440"
                            Visibility="{Binding HasSavedShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <Grid Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Top" DockPanel.Dock="Left">
                                <Ellipse Fill="{DynamicResource WolfGreenBrush}"/>
                                <Path Data="M 6,11.5 L 9.5,15 L 16,8" Stroke="{DynamicResource WolfGreenContrastBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="Shortcut saved" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding LastSavedShortcutPath}" Style="{StaticResource Caption}" Margin="0,2,0,0" ToolTip="{Binding LastSavedShortcutPath}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding StreamDeckSetupNote}" Style="{StaticResource StepBody}" FontSize="12" Foreground="{DynamicResource WolfDimBrush}" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- 3. Add it to Stream Deck -->
                <StackPanel x:Name="Step3" VerticalAlignment="Top" Visibility="Collapsed">
                    <ContentControl Style="{StaticResource StepBadge}" Content="3"/>
                    <TextBlock Text="Add it to Stream Deck" Style="{StaticResource StepTitle}"/>
                    <TextBlock Text="In the Stream Deck app, drag System › Open onto an empty key. Under App / File, pick the shortcut you saved." Style="{StaticResource StepBody}" Margin="0,0,0,18"/>

                    <!-- Mini picture of the Stream Deck app: the System actions list, Open dragged onto a key. -->
                    <Border CornerRadius="{StaticResource RadiusCard}" Padding="16,12" Background="{DynamicResource WolfPanelBrush}" BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" AutomationProperties.Name="Drag System, Open onto a Stream Deck key">
                        <StackPanel Orientation="Horizontal">
                            <!-- Actions list -->
                            <StackPanel Width="118" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                    <Path Data="M 0,0 L 6,0 L 3,4 Z" Fill="{DynamicResource WolfDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="System" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WolfMutedBrush}"/>
                                </StackPanel>
                                <Border CornerRadius="5" Padding="10,4" Margin="0,1">
                                    <TextBlock Text="Hotkey" FontSize="12" Foreground="{DynamicResource WolfDimBrush}"/>
                                </Border>
                                <Border CornerRadius="5" Padding="10,4" Margin="0,1" Background="{DynamicResource WolfAccentHoverBrush}" BorderBrush="{DynamicResource WolfGreenBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <controls:PhosphorIcon DockPanel.Dock="Left" IconName="AppWindow" IconSize="12" Width="13" Height="13" IconBrush="{DynamicResource WolfGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open" FontSize="12" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </Border>
                                <Border CornerRadius="5" Padding="10,4" Margin="0,1">
                                    <TextBlock Text="Website" FontSize="12" Foreground="{DynamicResource WolfDimBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Drag arrow -->
                            <Grid Width="70" Height="40" Margin="6,0" VerticalAlignment="Center">
                                <Path Data="M 4,26 C 22,4 46,4 62,20" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.6" StrokeDashArray="3,2.5"
                                      StrokeDashCap="Round" Opacity="0.85"/>
                                <Path Data="M 55,19 L 63,21 L 61,13" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.85"/>
                                <TextBlock Text="drag" FontSize="11" Foreground="{DynamicResource WolfDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                            </Grid>

                            <!-- The key it lands on -->
                            <ContentPresenter Content="{Binding SelectedStreamDeckKey}" ContentTemplate="{StaticResource KeyTemplate}"
                                              IsHitTestVisible="False" Focusable="False" KeyboardNavigation.IsTabStop="False" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- The saved path to paste into App / File -->
                    <StackPanel Margin="0,18,0,0" MaxWidth="440" Visibility="{Binding HasSavedShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="App / File" Style="{StaticResource TinyLabel}" FontWeight="SemiBold" Margin="2,0,0,5"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Copy path" Click="CopyPath_Click" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="14,0" MinHeight="0" Height="32"/>
                            <TextBox Text="{Binding LastSavedShortcutPath, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Height="32"
                                     VerticalContentAlignment="Center" Padding="6,0" AutomationProperties.Name="Saved shortcut path"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource WolfDimBrush}"
                               Text="Save the shortcut in step 2 first. Its path will show here.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSavedShortcut}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 4. Name it and try it -->
                <StackPanel x:Name="Step4" VerticalAlignment="Top" Visibility="Collapsed">
                    <!-- Last step: a filled green tick instead of a number. -->
                    <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Ellipse Fill="{DynamicResource WolfGreenBrush}" Opacity="0.18" Margin="-6"/>
                        <Ellipse Fill="{DynamicResource WolfGreenBrush}"/>
                        <Path Data="M 18,29 L 25,36 L 39,21" Stroke="{DynamicResource WolfGreenContrastBrush}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <TextBlock Text="Name it and try it" Style="{StaticResource StepTitle}"/>
                    <TextBlock Style="{StaticResource StepBody}" Text="Give the key a title, like your headphones' name. Then press it. Your device switches to that slot, and the lights follow if that's on in Lights."/>
                    <Border CornerRadius="{StaticResource RadiusCard}" Padding="12,9" Background="{DynamicResource WolfPanel2Brush}" BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" MaxWidth="420">
                        <DockPanel>
                            <controls:PhosphorIcon DockPanel.Dock="Left" IconName="Lightbulb" IconSize="15" Width="16" Height="16" IconBrush="{DynamicResource WolfWarningBrush}"
                                                   Margin="0,0,9,0" VerticalAlignment="Top"/>
                            <TextBlock Text="Save or discard EQ edits in WolfEQ first, or the key waits." Style="{StaticResource Caption}"/>
                        </DockPanel>
                    </Border>
                    <Button Click="Another_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Margin="0,22,0,0" Padding="14,6" MinHeight="32">
                        <StackPanel Orientation="Horizontal">
                            <controls:PhosphorIcon IconName="Plus" IconSize="13" Width="14" Height="14" IconBrush="{DynamicResource WolfMutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Set up another key" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Back · dots · Next / Finish -->
            <Border Grid.Row="2" CornerRadius="0,0,11,11" Background="{DynamicResource WolfShellBrush}"
                    BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource NavButton}" Click="Back_Click" VerticalAlignment="Center"/>
                    <StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                AutomationProperties.Name="Step progress"/>
                    <Button x:Name="NextButton" Grid.Column="2" Content="Next" Style="{StaticResource NavPrimaryButton}" IsDefault="True"
                            Click="Next_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
