<UserControl x:Class="WolfEQ.Views.LibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:WolfEQ.Controls"
             xmlns:models="clr-namespace:WolfEQ.Models"
             mc:Ignorable="d"
             d:DesignWidth="460"
             d:DesignHeight="820"
             Width="460"
             Foreground="{DynamicResource WolfTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="PreviewViewChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Rail" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="10,7">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/><Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rail" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- Copied from MainWindow resources; views keep their own template copies. -->
        <DataTemplate x:Key="LibraryPresetListItemTemplate" DataType="{x:Type models:EqPreset}">
            <Grid Margin="4,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Row delete: shown on hover or when the row is selected. -->
                <Button x:Name="RowDeleteButton" Grid.Column="1" Grid.RowSpan="2" Click="RowDeleteButton_Click"
                        Width="30" Height="30" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" Focusable="False"
                        ToolTip="Delete preset" AutomationProperties.Name="Delete preset">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="7">
                                <Path x:Name="Glyph" Data="M3,5 H17 M7,5 V2 H13 V5 M5,5 V18 H15 V5 M8,8 V15 M12,8 V15" Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{DynamicResource WolfMutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#26FF5555"/>
                                    <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource WolfDangerBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <DockPanel Grid.Row="1" Margin="0,3,0,0">
                    <TextBlock Text="{Binding Category}"
                               Style="{StaticResource TinyLabel}"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding PreampDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                               Style="{StaticResource TinyLabel}"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OnlineProfileListItemTemplate">
            <Grid Margin="4,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding SourceSummary}"
                           Style="{StaticResource TinyLabel}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,3,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- Compact row action for the Import / Export list. -->
        <Style x:Key="IoActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource WolfPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineSoftBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <!-- My Library / Online source chip (mutually exclusive, chip-styled radios). -->
        <Style x:Key="SourceChip" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ActiveRail"
                                    Height="2"
                                    Margin="12,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource WolfGreenBrush}"
                                    CornerRadius="2"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                            </Trigger>
                            <!-- Checked wins over hover; declared last. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                                <Setter TargetName="ActiveRail" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header: title, preset count, close -->
            <Grid Grid.Row="0" Margin="2,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36"
                        Height="36"
                        Background="{DynamicResource WolfAccentHoverBrush}"
                        BorderBrush="{DynamicResource WolfLineSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <controls:PhosphorIcon IconName="Folder"
                                           IconSize="18"
                                           IconBrush="{DynamicResource WolfGreenBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Preset library"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FilteredPresetCount, StringFormat={}{0} presets ready to load}"
                               Style="{StaticResource DimText}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Style="{StaticResource OverlayCloseButton}"
                        VerticalAlignment="Center"
                        ToolTip="Close the library"
                        Click="CloseButton_Click">
                    <Path Width="11"
                          Height="11"
                          Data="M 1,1 L 10,10 M 10,1 L 1,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- 2. Library source navigation -->
            <Border Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="3"
                    Background="Transparent"
                    BorderBrush="{DynamicResource WolfLineBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="MyLibrarySourceChip"
                             Style="{StaticResource SourceChip}"
                             GroupName="LibrarySource"
                             IsChecked="True"
                             Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:PhosphorIcon IconName="Folder"
                                               IconSize="16"
                                               IconBrush="{DynamicResource WolfGreenBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="My Library" FontWeight="SemiBold"/>
                            <TextBlock Text="Saved profiles" Style="{StaticResource TinyLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="OnlineSourceChip"
                             Grid.Column="1"
                             Style="{StaticResource SourceChip}"
                             GroupName="LibrarySource"
                             Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:PhosphorIcon IconName="Cloud"
                                               IconSize="16"
                                               IconBrush="{DynamicResource WolfCyanBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="Discover Online" FontWeight="SemiBold"/>
                            <TextBlock Text="AutoEQ + OPRA" Style="{StaticResource TinyLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
            </Grid>
            </Border>

            <!-- Compact local-library toolbar; online search keeps its own controls. -->
            <Grid Grid.Row="2" Margin="0,0,0,12"
                  Visibility="{Binding IsChecked, ElementName=MyLibrarySourceChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="LibrarySearchBox" Text="{Binding ProfileSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" FontSize="12" Padding="32,0,10,0" Background="{DynamicResource WolfShellBrush}"
                             BorderBrush="{DynamicResource WolfLineBrush}" AutomationProperties.Name="Search saved presets" ToolTip="Filter saved presets"/>
                    <controls:PhosphorIcon IconName="MagnifyingGlass" IconSize="14" IconBrush="{DynamicResource WolfMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Search presets" FontSize="12" Margin="32,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource WolfDimBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LibrarySearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid>
                <Button Grid.Column="1" Command="{Binding CreateFlatPresetCommand}" Style="{StaticResource QuietButton}"
                        Height="36" Margin="8,0,0,0" Padding="12,0" Background="{DynamicResource WolfAccentHoverBrush}"
                        BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="1" ToolTip="Create a new flat preset" AutomationProperties.Name="New preset">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M0,6 H12 M6,0 V12" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="New" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="2"
                    Margin="0,0,0,10"
                    Padding="12"
                    Background="{DynamicResource WolfShellBrush}"
                    BorderBrush="{DynamicResource WolfLineSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                  Visibility="{Binding IsChecked, ElementName=OnlineSourceChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="30" Height="30" Background="{DynamicResource WolfAccentHoverBrush}" CornerRadius="7" Margin="0,0,9,0">
                            <controls:PhosphorIcon IconName="MagnifyingGlass"
                                                   IconSize="15"
                                                   IconBrush="{DynamicResource WolfCyanBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Find your headphones" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Search community measurements and tunings"
                                       Style="{StaticResource DimText}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OnlineSearchBox"
                                 Text="{Binding GitHubProfileSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 KeyDown="OnlineSearchBox_KeyDown"
                                 AutomationProperties.Name="Search online headphone profiles"
                                 ToolTip="Search AutoEQ and OPRA headphone presets"/>
                        <Button Grid.Column="1"
                                Content="Search"
                                Command="{Binding SearchGitHubProfilesCommand}"
                                Style="{StaticResource FiioButton}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. My Library source -->
            <Grid Grid.Row="3"
                  Visibility="{Binding IsChecked, ElementName=MyLibrarySourceChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredPresets}"
                         SelectedItem="{Binding LibrarySelection}"
                         x:Name="SavedPresetList" IsSynchronizedWithCurrentItem="False"
                         KeyDown="SavedPresetList_KeyDown"
                         ItemTemplate="{StaticResource LibraryPresetListItemTemplate}"
                         MinHeight="120"/>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=SavedPresetList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers></Style></StackPanel.Style>
                    <controls:PhosphorIcon IconName="MagnifyingGlass" IconSize="24" IconBrush="{DynamicResource WolfGreenBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No presets found" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try another search or create a preset." Style="{StaticResource DimText}" Margin="0,5,0,0"/>
                </StackPanel>

                <Border x:Name="LibrarySelectionActions" Grid.Row="2" Visibility="{Binding HasItems, ElementName=SavedPresetList, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding LibrarySelection.Name, TargetNullValue=Select a preset}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,0,0,10"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="OpenPresetButton" Click="OpenPresetButton_Click" Margin="0,0,8,0" Padding="12,10">

                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SavePresetButton}"><Style.Triggers><DataTrigger Binding="{Binding LibrarySelection}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel Orientation="Horizontal"><controls:PhosphorIcon IconName="SlidersHorizontal" IconSize="17" IconBrush="{DynamicResource WolfGreenContrastBrush}" Margin="0,0,8,0"/><TextBlock Text="Open in editor" Foreground="{DynamicResource WolfGreenContrastBrush}"/></StackPanel>
                            </Button>
                            <ToggleButton x:Name="PresetActionsButton" Grid.Column="1" Width="42" Style="{StaticResource StudioMenuToggle}" IsChecked="{Binding IsOpen, ElementName=PresetActionsPopup, Mode=TwoWay}" ToolTip="Actions for this preset" AutomationProperties.Name="Preset actions">
                                <!-- Drawn dots: the U+22EF glyph clipped to two dots at this size. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                    <Ellipse Width="4" Height="4" Margin="3,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                    <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup x:Name="PresetActionsPopup" PlacementTarget="{Binding ElementName=PresetActionsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Width="230" Padding="8" Background="{DynamicResource WolfPanelBrush}" BorderBrush="{DynamicResource WolfLineSoftBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <Button Command="{Binding DuplicatePresetCommand}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Click="PresetAction_Click"><StackPanel Orientation="Horizontal"><Path Data="M5,2 H18 V15 H5 Z M2,5 V18 H15" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.5" Margin="0,0,10,0"/><TextBlock Text="Duplicate preset" Foreground="{DynamicResource WolfTextBrush}"/></StackPanel></Button>
                                        <Button Command="{Binding WriteLibraryPresetToSlotCommand}" Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Click="PresetAction_Click"><StackPanel Orientation="Horizontal"><Path Data="M10,2 V13 M5,8 L10,13 L15,8 M3,14 V18 H17 V14" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.5" Margin="0,0,10,0"/><TextBlock Text="Write to device slot" Foreground="{DynamicResource WolfTextBrush}"/></StackPanel></Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Online source -->
            <Grid Grid.Row="3"
                  Visibility="{Binding IsChecked, ElementName=OnlineSourceChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding GitHubProfiles}"
                         SelectedItem="{Binding SelectedGitHubProfile}"
                         ItemTemplate="{StaticResource OnlineProfileListItemTemplate}"
                         MinHeight="150"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding GitHubProfileStatus}"
                           Style="{StaticResource DimText}"
                           TextTrimming="CharacterEllipsis"
                           Margin="2,8,0,8"/>

                <Border Grid.Row="2"
                        Background="{DynamicResource WolfPanel2Brush}"
                        BorderBrush="{DynamicResource WolfLineSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="8,0,12,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <RadioButton x:Name="PreviewCurveChoice" Content="Curve" GroupName="OnlinePreviewView" Style="{StaticResource PreviewViewChoice}" IsChecked="{Binding IsSelected, ElementName=PreviewCurveTab, Mode=OneWay}" Tag="0" Click="PreviewView_Click"/>
                                <RadioButton x:Name="PreviewTableChoice" Content="Table" GroupName="OnlinePreviewView" Style="{StaticResource PreviewViewChoice}" IsChecked="{Binding IsSelected, ElementName=PreviewTableTab, Mode=OneWay}" Tag="1" Click="PreviewView_Click"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GitHubPreviewPreset.PreampDb, StringFormat=Preamp {0:+0.0;-0.0;0.0} dB, TargetNullValue=Select a profile}" Style="{StaticResource TinyLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TabControl x:Name="OnlinePreviewTabs" Grid.Row="1" Height="190" BorderThickness="0" Background="Transparent" Padding="0">
                            <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
                            <TabItem x:Name="PreviewCurveTab" Header="Curve">
                                <controls:EqResponseGraphControl Bands="{Binding GitHubPreviewPreset.Bands}" PreampDb="{Binding GitHubPreviewPreset.PreampDb, TargetNullValue=0}" IsInteractive="False" MinGainDb="-12" MaxGainDb="12" MinHeight="0"/>
                            </TabItem>
                            <TabItem x:Name="PreviewTableTab" Header="Table">
                                <DataGrid x:Name="OnlinePreviewTable" ItemsSource="{Binding GitHubPreviewPreset.Bands}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource WolfLineBrush}" BorderThickness="0" Background="{DynamicResource WolfPanelBrush}" RowBackground="{DynamicResource WolfPanelBrush}" AlternatingRowBackground="{DynamicResource WolfShellBrush}" FontSize="11" RowHeight="29" ColumnHeaderHeight="28" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="5,0" AutomationProperties.Name="Online preset band settings">
                                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="29"/></Style></DataGrid.RowStyle>
                                    <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0"/></Style></DataGrid.Resources>
                                    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/><Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/><Setter Property="Padding" Value="4"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="28"/>
                                        <DataGridTemplateColumn Header="State" Width="48" SortMemberPath="Enabled"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock VerticalAlignment="Center" Margin="4,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="On"/><Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Text" Value="Off"/><Setter Property="Foreground" Value="{DynamicResource WolfDimBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Filter" Binding="{Binding FilterType}" Width="95"/>
                                        <DataGridTextColumn Header="Hz" Binding="{Binding FrequencyHz, StringFormat={}{0:N0}}" Width="80"/>
                                        <DataGridTextColumn Header="dB" Binding="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}" Width="65"/>
                                        <DataGridTextColumn Header="Q" Binding="{Binding Q, StringFormat={}{0:F2}}" Width="62"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="Profiles are saved to My Library before they are opened or written."
                               Style="{StaticResource DimText}"
                               Margin="2,0,0,7"/>
                    <Button Command="{Binding ImportGitHubProfileCommand}"
                            Style="{StaticResource FiioButton}"
                            Margin="0,0,0,6"
                            ToolTip="Download this profile without replacing the current editor curve">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:PhosphorIcon IconName="Plus"
                                                   IconSize="14"
                                                   IconBrush="{DynamicResource WolfGreenBrush}"
                                                   Margin="0,0,7,0"/>
                            <TextBlock Text="Save to My Library" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <UniformGrid>
                        <UniformGrid.Style>
                            <Style TargetType="UniformGrid">
                                <Setter Property="Columns" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemEqSelected}" Value="True"><Setter Property="Columns" Value="1"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </UniformGrid.Style>
                        <Button Content="Open in editor"
                                Command="{Binding LoadOnlineProfileIntoEditorCommand}"
                                Style="{StaticResource QuietButton}"
                                ToolTip="Save this profile and open it in the editor"/>
                        <Button Content="Write to current slot"
                                Command="{Binding WriteOnlineProfileToSlotCommand}"
                                Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource AccentButton}"
                                ToolTip="Save this profile and write it to the selected device slot"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- 6. Single import/export cluster (R18) -->
            <Expander Grid.Row="4"
                      Header="Import / export"
                      Foreground="{DynamicResource WolfMutedBrush}"
                      Margin="0,12,0,0">
                <StackPanel Margin="0,8,0,0">
                    <!-- Import / Export switch, same chip look as My Library / Discover Online. -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <RadioButton x:Name="ImportModeChip" Style="{StaticResource SourceChip}" GroupName="IoMode" IsChecked="True" MinHeight="36" AutomationProperties.Name="Import">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:PhosphorIcon IconName="Plus" IconSize="14" IconBrush="{DynamicResource WolfGreenBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Import" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ExportModeChip" Grid.Column="1" Style="{StaticResource SourceChip}" GroupName="IoMode" MinHeight="36" Margin="2,0,0,0" AutomationProperties.Name="Export">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:PhosphorIcon IconName="ArrowRight" IconSize="14" IconBrush="{DynamicResource WolfCyanBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Export" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <StackPanel x:Name="ImportRows" Visibility="{Binding IsChecked, ElementName=ImportModeChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Imported presets are added to My Library." Style="{StaticResource TinyLabel}" Margin="2,0,0,8"/>
                        <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WolfPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <controls:PhosphorIcon IconName="SlidersHorizontal" IconSize="15" IconBrush="{DynamicResource WolfGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Equalizer APO / Peace" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text=".txt filters from Peace, AutoEq, or APO" Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open file" Command="{Binding ImportApoFromFileCommand}" Style="{StaticResource IoActionButton}" ToolTip="Import an Equalizer APO or Peace .txt file"/>
                                    <Button Content="Paste" Command="{Binding ImportApoFromClipboardCommand}" Style="{StaticResource IoActionButton}" ToolTip="Import Equalizer APO text from the clipboard"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WolfPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <controls:PhosphorIcon IconName="Cpu" IconSize="15" IconBrush="{DynamicResource WolfCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="FiiO PEQ file" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text=".xml presets from the FiiO Control app" Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open file" Command="{Binding ImportFiioXmlFromFileCommand}" Style="{StaticResource IoActionButton}" ToolTip="Import a FiiO .xml preset"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WolfPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <controls:PhosphorIcon IconName="MusicNote" IconSize="15" IconBrush="{DynamicResource WolfGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="WolfEQ preset" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="A single preset shared from WolfEQ (.json)" Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open file" Command="{Binding ImportJsonFromFileCommand}" Style="{StaticResource IoActionButton}" ToolTip="Import a WolfEQ preset .json file"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WolfPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <controls:PhosphorIcon IconName="Folder" IconSize="15" IconBrush="{DynamicResource WolfCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Library backup" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Adds every preset from a WolfEQ backup" Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open file" Command="{Binding ImportLibraryJsonCommand}" Style="{StaticResource IoActionButton}" ToolTip="Import a whole WolfEQ library backup"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ExportRows" Visibility="{Binding IsChecked, ElementName=ExportModeChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="2,0,0,8">
                            <Run Text="Exports the preset open in the editor:"/>
                            <Run Text="{Binding SelectedPreset.Name, Mode=OneWay, TargetNullValue='open a preset first'}" Foreground="{DynamicResource WolfTextBrush}"/>
                        </TextBlock>
                        <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WolfPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <controls:PhosphorIcon IconName="SlidersHorizontal" IconSize="15" IconBrush="{DynamicResource WolfGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Equalizer APO / Peace" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="For Peace, APO, or sharing as text" Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Save file" Command="{Binding ExportApoToFileCommand}" Style="{StaticResource IoActionButton}" ToolTip="Save the open preset as an Equalizer APO .txt file"/>
                                    <Button Content="Copy" Command="{Binding ExportApoToClipboardCommand}" Style="{StaticResource IoActionButton}" ToolTip="Copy the open preset as Equalizer APO text"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WolfPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <controls:PhosphorIcon IconName="Cpu" IconSize="15" IconBrush="{DynamicResource WolfCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="FiiO PEQ file" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="For the FiiO Control app (.xml)" Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Save file" Command="{Binding ExportFiioXmlToFileCommand}" Style="{StaticResource IoActionButton}" ToolTip="Save the open preset as a FiiO .xml file"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WolfPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <controls:PhosphorIcon IconName="MusicNote" IconSize="15" IconBrush="{DynamicResource WolfGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="WolfEQ preset" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Share this preset with another WolfEQ (.json)" Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Save file" Command="{Binding ExportJsonToFileCommand}" Style="{StaticResource IoActionButton}" ToolTip="Save the open preset as a WolfEQ .json file"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WolfPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <controls:PhosphorIcon IconName="Folder" IconSize="15" IconBrush="{DynamicResource WolfCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Library backup" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Every preset in your library, one file" Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Save file" Command="{Binding ExportLibraryJsonCommand}" Style="{StaticResource IoActionButton}" ToolTip="Back up your whole WolfEQ library"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WolfPanelBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <controls:PhosphorIcon IconName="AppWindow" IconSize="15" IconBrush="{DynamicResource WolfMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Tuning report" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Readable summary of the current EQ" Style="{StaticResource TinyLabel}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Copy" Command="{Binding CopyTuningReportCommand}" Style="{StaticResource IoActionButton}" ToolTip="Copy a readable tuning report to the clipboard"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </Grid>
    </Border>
</UserControl>
