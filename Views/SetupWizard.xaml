<Window x:Class="WolfEQ.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WolfEQ.Controls"
        Title="WolfEQ setup"
        Width="692" Height="704"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource WolfTextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StepBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
        </Style>
        <Style x:Key="NavPrimaryButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{DynamicResource WolfGreenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfGreenContrastBrush}"/>
        </Style>

        <!-- A card you can pick: green edge on hover, focus and when chosen (Tag=True). -->
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="{StaticResource RadiusCard}" Padding="14,10" Background="{DynamicResource WolfPanelBrush}"
                                BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource WolfPanel2Brush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/></Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="{StaticResource RadiusOverlay}" Background="{DynamicResource WolfBgBrush}"
            BorderBrush="{DynamicResource WolfLineSoftBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.6"/>
        </Border.Effect>
        <Grid KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="{DynamicResource WolfShellBrush}"
                    BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="16,0,12,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource OverlayCloseButton}" Click="Close_Click" ToolTip="Skip setup (Esc)"
                            AutomationProperties.Name="Skip setup" VerticalAlignment="Center" IsTabStop="False">
                        <Path Width="10" Height="10" Data="M 1,1 L 9,9 M 9,1 L 1,9" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="32" Height="32" Margin="0,0,11,0">
                            <Border CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource WolfGreenBrush}" Opacity="0.16"/>
                            <controls:PhosphorIcon IconName="SlidersHorizontal" IconSize="16" IconBrush="{DynamicResource WolfGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="WolfEQ setup" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="Steps" Grid.Row="1" Margin="36,20,36,12" RenderTransformOrigin="0.5,0.5">
                <!-- 1. Device -->
                <DockPanel x:Name="Step1">
                    <StackPanel DockPanel.Dock="Top">
                        <!-- The picture pulses while WolfEQ looks for a device. -->
                        <Grid Width="148" Height="118" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse x:Name="Pulse1" Width="92" Height="92" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
                            <Ellipse x:Name="Pulse2" Width="92" Height="92" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
                            <Ellipse Width="92" Height="92" Fill="{DynamicResource WolfPanelBrush}" Stroke="{DynamicResource WolfLineSoftBrush}"/>
                            <Image Source="{Binding DeviceDockImagePath}" Width="72" Height="58" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock x:Name="DeviceTitle" Text="Plug in your DAC" Style="{StaticResource StepTitle}"/>
                        <TextBlock x:Name="DeviceBody" Style="{StaticResource StepBody}" Text="WolfEQ is looking for it over USB. Nothing is written to your device during setup."/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,0">
                            <ItemsControl ItemsSource="{Binding SetupDevices}" Focusable="False" AutomationProperties.Name="Devices found">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChoiceCard}" Tag="{Binding IsCurrent}" Click="Device_Click" AutomationProperties.Name="{Binding Title}">
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left" Source="{Binding ImagePath}" Width="56" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="SoftwareEqCard" Style="{StaticResource ChoiceCard}" Tag="{Binding IsSystemEqSelected}" Click="SoftwareEq_Click" AutomationProperties.Name="Use Software EQ">
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Source="pack://application:,,,/WolfEQ;component/Assets/devices/windows-system-eq.png" Width="56" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Software EQ" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="For any headphones, speakers or DAC on this PC" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button x:Name="ShowModelsButton" Style="{StaticResource QuietButton}" Click="ShowModels_Click" HorizontalAlignment="Center" Content="My device isn't listed"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- 1b. Every model, on a page of its own so there is only one thing to scroll. -->
                <DockPanel x:Name="ModelPicker" Visibility="Collapsed" Margin="0,0,0,-12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Choose your device" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="You can plug it in later." Style="{StaticResource StepBody}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="ModelSearchBox" Height="38" VerticalContentAlignment="Center" Padding="34,0,10,0" TextChanged="ModelSearch_TextChanged"
                                     PreviewKeyDown="ModelSearch_PreviewKeyDown" AutomationProperties.Name="Search devices"/>
                            <controls:PhosphorIcon IconName="MagnifyingGlass" IconSize="15" IconBrush="{DynamicResource WolfDimBrush}" IsHitTestVisible="False"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="Search devices" Foreground="{DynamicResource WolfDimBrush}" FontSize="13" IsHitTestVisible="False" VerticalAlignment="Center" Margin="38,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ModelSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <ScrollViewer x:Name="ModelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-20,0" Padding="0,0,12,0" Focusable="False">
                        <StackPanel>
                            <ItemsControl x:Name="ModelList" Focusable="False" AutomationProperties.Name="All models">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChoiceCard}" Margin="0,0,8,8" Height="112" Click="Model_Click" AutomationProperties.Name="{Binding DisplayLabel}">
                                            <StackPanel>
                                                <Image Source="{Binding ProductImagePath}" Height="52" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="-6,4,-6,0"/>
                                                <TextBlock x:Name="Experimental" Text="experimental" FontSize="10.5" Foreground="{DynamicResource WolfDimBrush}" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <DataTemplate.Triggers><DataTrigger Binding="{Binding IsVerified}" Value="True"><Setter TargetName="Experimental" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoModelsText" Text="No match." Style="{StaticResource StepBody}" Visibility="Collapsed" Margin="0,12,0,0"/>
                            <TextBlock Text="Still not there? Use Software EQ, or send us a report so we can add it." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,4"/>
                            <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Content="Run device diagnostic" Command="{Binding RunHidDiagnosticCommand}" ToolTip="Copies a read-only report of your USB device"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" TextAlignment="Center" Margin="0,0,0,12"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- 2. Good to know -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <Image Source="{Binding SelectedDeviceProfile.ProductImagePath}" Height="104" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding SelectedDeviceProfile.DisplayLabel}" Style="{StaticResource StepTitle}"/>
                    <TextBlock Text="{Binding SetupConnectionText}" Style="{StaticResource StepBody}"/>
                    <ItemsControl ItemsSource="{Binding SetupTips}" Focusable="False" Margin="20,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{StaticResource RadiusCard}" Padding="12,10" Margin="0,0,0,8" Background="{DynamicResource WolfPanelBrush}" BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <controls:PhosphorIcon DockPanel.Dock="Left" IconName="Lightbulb" IconSize="16" IconBrush="{DynamicResource WolfGreenBrush}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding InstallEqualizerApoCommand}" Content="Install Equalizer APO..." HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FiioButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SystemEqState}" Value="NeedsInstall"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Command="{Binding OpenApoDeviceSelectorCommand}" Content="Choose outputs..." HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FiioButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SystemEqState}" Value="NeedsDeviceSelection"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </StackPanel>

                <!-- 3. Headphones -->
                <DockPanel x:Name="Step3" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Find your headphones" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="Start from a free AutoEq or OPRA preset, or skip this and start from scratch." Style="{StaticResource StepBody}"/>
                        <DockPanel Margin="20,0,20,8">
                            <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchGitHubProfilesCommand}" Style="{StaticResource FiioButton}" Height="38" Margin="8,0,0,0" Padding="16,0" FontWeight="SemiBold"/>
                            <TextBox x:Name="SearchBox" Text="{Binding GitHubProfileSearchText, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" Padding="10,0"
                                     PreviewKeyDown="Search_PreviewKeyDown" AutomationProperties.Name="Headphone name" ToolTip="For example HD 600 or Sundara"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,8,20,0">
                        <Border CornerRadius="{StaticResource RadiusCard}" BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="1" Background="{DynamicResource WolfPanelBrush}" Height="150" Padding="6">
                            <controls:EqResponseGraphControl Bands="{Binding GitHubPreviewPreset.Bands}" PreampDb="{Binding GitHubPreviewPreset.PreampDb, TargetNullValue=0, FallbackValue=0}" IsInteractive="False" MinGainDb="-12" MaxGainDb="12" MinHeight="0"/>
                        </Border>
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="UsePresetButton" DockPanel.Dock="Right" Content="Use this EQ" Click="UsePreset_Click" Style="{StaticResource AccentButton}" Height="34" Padding="16,0" Margin="8,0,0,0"/>
                            <TextBlock x:Name="PresetStatus" Text="{Binding GitHubProfileStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding GitHubProfiles}" SelectedItem="{Binding SelectedGitHubProfile}" IsSynchronizedWithCurrentItem="False" Margin="20,0"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Headphone presets">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource DimText}" TextTrimming="CharacterEllipsis"><Run Text="{Binding SourceSummary, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Provider, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- 4. Ready -->
                <StackPanel x:Name="Step4" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Ellipse Fill="{DynamicResource WolfGreenBrush}" Opacity="0.18" Margin="-7"/>
                        <Ellipse Fill="{DynamicResource WolfGreenBrush}"/>
                        <Path Data="M 20,33 L 28,41 L 45,24" Stroke="{DynamicResource WolfGreenContrastBrush}" StrokeThickness="3.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <TextBlock Text="You're ready" Style="{StaticResource StepTitle}"/>
                    <TextBlock Text="Turn your volume down before your first save, then bring it back up." Style="{StaticResource StepBody}"/>
                    <Border CornerRadius="{StaticResource RadiusCard}" Padding="18,14" MaxWidth="420" Background="{DynamicResource WolfPanelBrush}" BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="1">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="{Binding DeviceDockImagePath}" Width="72" Height="58" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeviceDockTitle}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EqSummary" Text="Starting from the EQ in the editor" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="You can run this again from Settings." Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" CornerRadius="0,0,11,11" Background="{DynamicResource WolfShellBrush}"
                    BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource NavButton}" Click="Back_Click" VerticalAlignment="Center"/>
                    <StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="NextButton" Grid.Column="2" Content="Next" Style="{StaticResource NavPrimaryButton}" IsDefault="True" Click="Next_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
