<UserControl x:Class="WolfEQ.Views.EditorWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:WolfEQ.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="700"
             Foreground="{StaticResource WolfTextBrush}">
    <UserControl.Resources>
        <Style x:Key="CapsuleValueBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BandValueTextBox}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
        </Style>

        <Style x:Key="CapsulePowerToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Enable or bypass this band"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <Ellipse x:Name="PowerRing"
                                     Fill="#10161B"
                                     Stroke="{StaticResource WolfDimBrush}"
                                     StrokeThickness="1.5"/>
                            <TextBlock x:Name="PowerGlyph"
                                       Text="⏻"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="18"
                                       Foreground="{StaticResource WolfDimBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PowerRing" Property="Fill" Value="{StaticResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="PowerRing" Property="Stroke" Value="{StaticResource WolfGreenBrush}"/>
                                <Setter TargetName="PowerGlyph" Property="Foreground" Value="{StaticResource WolfGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PowerRing" Property="Stroke" Value="{StaticResource WolfCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CapsuleCloseButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource WolfMutedBrush}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfCyanDimBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource WolfCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolActionButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfCyanDimBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6606B6D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolGlyph" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{StaticResource WolfCyanBrush}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolMacroButton" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="62"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource WolfShellBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfCyanDimBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6606B6D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolMenuToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfCyanDimBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolMenuSectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource WolfDimBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,8,10,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The graph is the band editor. All band-specific chrome is contextual. -->
        <Border Grid.Row="0"
                Style="{StaticResource PanelBorder}"
                Padding="0"
                Margin="0,0,0,12">
            <Grid Margin="12,10,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="4,0,4,8">
                    <TextBlock Text="EQ Curve"
                               Style="{StaticResource SectionTitle}"
                               DockPanel.Dock="Left"
                               Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Drag points · wheel or handles adjust Q · Alt-click bypass"
                                   Style="{StaticResource DimText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,18,0"/>
                        <TextBlock Text="20 Hz – 20 kHz"
                                   Style="{StaticResource DimText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <controls:EqResponseGraphControl x:Name="Graph"
                                                     MinHeight="300"
                                                     Bands="{Binding Bands}"
                                                     CompareBands="{Binding ComparePreset.Bands}"
                                                     PreampDb="{Binding PreampDb}"
                                                     IsInteractive="True"
                                                     MinGainDb="{Binding SelectedDeviceProfile.MinGainDb}"
                                                     MaxGainDb="{Binding SelectedDeviceProfile.MaxGainDb}"
                                                     MinQ="{Binding SelectedDeviceProfile.MinQ}"
                                                     MaxQ="{Binding SelectedDeviceProfile.MaxQ}"/>

                    <!-- Interactive overlay. The canvas itself is transparent to the graph;
                         only the capsule receives pointer input. -->
                    <Canvas x:Name="BandEditorCanvas" Panel.ZIndex="20">
                        <Border x:Name="CapsuleStem"
                                Width="1.5"
                                Background="{StaticResource WolfCyanBrush}"
                                Opacity="0.78"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedBand, ElementName=Graph}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Border x:Name="BandEditorCapsule"
                                Width="700"
                                Height="58"
                                Padding="10,8"
                                Background="#F20B1116"
                                BorderBrush="#9906B6D4"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="5" Opacity="0.62" Direction="270"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedBand, ElementName=Graph}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="106"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="98"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0"
                                              Style="{StaticResource CapsulePowerToggle}"
                                              IsChecked="{Binding SelectedBand.Enabled, ElementName=Graph, Mode=TwoWay}"
                                              Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedBandDisplayNumber, ElementName=Graph, StringFormat=B{0}}"
                                           Foreground="{StaticResource WolfGreenBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,13,0"/>

                                <Rectangle Grid.Column="2" Fill="{StaticResource WolfLineSoftBrush}" Margin="0,1"/>

                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding Source={x:Static controls:EqFilterTypeValues.All}}"
                                          SelectedItem="{Binding SelectedBand.FilterType, ElementName=Graph, Mode=TwoWay}"
                                          MinHeight="32"
                                          Padding="8,5"
                                          Margin="10,0"/>

                                <Rectangle Grid.Column="4" Fill="{StaticResource WolfLineSoftBrush}" Margin="0,1"/>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBox x:Name="FrequencyBox"
                                             Width="68"
                                             Tag="Frequency"
                                             Style="{StaticResource CapsuleValueBox}"
                                             Text="{Binding SelectedBand.FrequencyHz, ElementName=Graph, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                             KeyDown="StripValueBox_KeyDown"
                                             LostFocus="StripValueBox_LostFocus"/>
                                    <TextBlock Text="Hz" Style="{StaticResource TinyLabel}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>

                                <Rectangle Grid.Column="6" Fill="{StaticResource WolfLineSoftBrush}" Margin="0,1"/>

                                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBox x:Name="GainBox"
                                             Width="57"
                                             Tag="Gain"
                                             Style="{StaticResource CapsuleValueBox}"
                                             Text="{Binding SelectedBand.GainDb, ElementName=Graph, Mode=TwoWay, UpdateSourceTrigger=Explicit, StringFormat={}{0:F1}}"
                                             KeyDown="StripValueBox_KeyDown"
                                             LostFocus="StripValueBox_LostFocus"/>
                                    <TextBlock Text="dB" Style="{StaticResource TinyLabel}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>

                                <Rectangle Grid.Column="8" Fill="{StaticResource WolfLineSoftBrush}" Margin="0,1"/>

                                <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Q" Style="{StaticResource TinyLabel}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="QBox"
                                             Width="58"
                                             Tag="Q"
                                             Style="{StaticResource CapsuleValueBox}"
                                             Text="{Binding SelectedBand.Q, ElementName=Graph, Mode=TwoWay, UpdateSourceTrigger=Explicit, StringFormat={}{0:F2}}"
                                             KeyDown="StripValueBox_KeyDown"
                                             LostFocus="StripValueBox_LostFocus"/>
                                </StackPanel>

                                <Rectangle Grid.Column="10" Fill="{StaticResource WolfLineSoftBrush}" Margin="0,1"/>

                                <Button Grid.Column="11"
                                        Content="×"
                                        Style="{StaticResource CapsuleCloseButton}"
                                        Click="DismissBandEditor_Click"
                                        ToolTip="Close band controls"
                                        Margin="9,0,0,0"/>
                            </Grid>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <!-- One compact utility footer; no persistent band list. -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="14,9">
            <Grid MinHeight="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Preamp"
                           Style="{StaticResource TinyLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <controls:StyledSlider Grid.Column="1"
                                       Minimum="{Binding SelectedDeviceProfile.MinGainDb}"
                                       Maximum="{Binding SelectedDeviceProfile.MaxGainDb}"
                                       Value="{Binding PreampDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Step="0.5"
                                       AccentColor="{DynamicResource WolfGreen}"
                                       ShowLabel="False"
                                       VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding PreampDb, StringFormat={}{0:F1} dB}"
                           Style="{StaticResource ValueText}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           MinWidth="62"
                           TextAlignment="Right"
                           Margin="12,0"/>

                <Rectangle Grid.Column="3" Fill="{StaticResource WolfLineSoftBrush}" Margin="6,2,16,2"/>

                <Border Grid.Column="4"
                        VerticalAlignment="Center"
                        Padding="2"
                        CornerRadius="8"
                        ToolTip="{Binding HeadroomGuardianText}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#B912171B"/>
                            <Setter Property="BorderBrush" Value="#5500E676"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeadroomGuardianTitle}" Value="Clipping Risk">
                                    <Setter Property="Background" Value="#19FFB800"/>
                                    <Setter Property="BorderBrush" Value="#88FFB800"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding ApplyAutoHeadroomCommand}"
                                Style="{StaticResource QuietButton}"
                                Background="{StaticResource WolfAccentHoverBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="7,4,10,4"
                                VerticalAlignment="Stretch"
                                ToolTip="Match preamp to the strongest enabled EQ boost">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28"
                                        Height="28"
                                        Background="#2400E676"
                                        BorderBrush="#6600E676"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Margin="0,0,8,0">
                                    <Path Width="16"
                                          Height="13"
                                          Stretch="Fill"
                                          Stroke="{DynamicResource WolfGreenBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M 1,11 L 4,8 L 7,9.5 L 11,3 L 15,5 M 1,12 L 15,12"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Optimize headroom"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource WolfTextBrush}"/>
                                    <TextBlock Text="{Binding OptimizedHeadroomPreviewText}"
                                               FontSize="9"
                                               Foreground="{StaticResource WolfMutedBrush}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Border Grid.Column="1"
                                Height="25"
                                Background="{StaticResource WolfLineSoftBrush}"
                                VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Margin="11,0,12,0"
                                    VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WolfGreenBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeadroomGuardianTitle}" Value="Clipping Risk">
                                                <Setter Property="Fill" Value="{StaticResource WolfWarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel>
                                <TextBlock Text="{Binding HeadroomGuardianTitle}"
                                           FontSize="11"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WolfGreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeadroomGuardianTitle}" Value="Clipping Risk">
                                                    <Setter Property="Foreground" Value="{StaticResource WolfWarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding HeadroomMarginText}"
                                           FontSize="9"
                                           Foreground="{StaticResource WolfMutedBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="14,0"
                        Padding="8,5"
                        Background="{StaticResource WolfAccentHoverBrush}"
                        BorderBrush="#6600E676"
                        BorderThickness="1"
                        CornerRadius="7"
                        ToolTip="{Binding CompareDeltaHint}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasComparePreset}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{StaticResource WolfGreenBrush}"
                                 Margin="0,0,7,0"/>
                        <TextBlock Text="A/B active"
                                   Foreground="{StaticResource WolfGreenBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ToggleButton Grid.Column="6"
                              x:Name="ToolsButton"
                              Style="{StaticResource ToolMenuToggle}"
                              IsChecked="{Binding IsOpen, ElementName=ToolsPopup, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Open editing tools">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tools" VerticalAlignment="Center"/>
                        <Path Width="9"
                              Height="5"
                              Margin="9,1,0,0"
                              VerticalAlignment="Center"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 1,1 L 4.5,4 L 8,1"/>
                    </StackPanel>
                </ToggleButton>

                <Popup x:Name="ToolsPopup"
                       PlacementTarget="{Binding ElementName=ToolsButton}"
                       Placement="Bottom"
                       HorizontalOffset="-289"
                       VerticalOffset="7"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                       Closed="ToolsPopup_Closed">
                    <Border Width="360"
                            Padding="8"
                            Background="#FC181A1C"
                            BorderBrush="{StaticResource WolfLineSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Effect="{StaticResource WolfComboShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="10,6,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30"
                                        Height="30"
                                        Background="{StaticResource WolfAccentHoverBrush}"
                                        BorderBrush="#5500E676"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Path Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource WolfGreenBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 2,4 L 14,4 M 5,8 L 14,8 M 8,12 L 14,12"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Editing tools" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Shape, compare, prepare, and share"
                                               Style="{StaticResource DimText}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="{StaticResource WolfLineBrush}" Margin="2,0"/>
                            <ScrollViewer Grid.Row="2"
                                          MaxHeight="530"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,2,0">
                            <StackPanel>
                            <TextBlock Text="QUICK TUNING" Style="{StaticResource ToolMenuSectionLabel}"/>
                            <TextBlock Text="Creates a new copy, so your original stays untouched."
                                       Style="{StaticResource DimText}"
                                       TextWrapping="Wrap"
                                       Margin="10,0,10,5"/>

                            <UniformGrid Columns="2" Margin="-1,0,-1,3">
                                <Button Style="{StaticResource ToolMacroButton}"
                                        Command="{Binding AddBassPunchCommand}"
                                        Click="ToolMenuItem_Click"
                                        AutomationProperties.Name="Create a Bass Punch copy">
                                    <StackPanel>
                                        <TextBlock Text="Bass Punch" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Weight + impact" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolMacroButton}"
                                        Command="{Binding AddWarmTiltCommand}"
                                        Click="ToolMenuItem_Click"
                                        AutomationProperties.Name="Create a Warm Tilt copy">
                                    <StackPanel>
                                        <TextBlock Text="Warm Tilt" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Relaxed listening" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolMacroButton}"
                                        Command="{Binding AddTrebleTamerCommand}"
                                        Click="ToolMenuItem_Click"
                                        AutomationProperties.Name="Create a Treble Tamer copy">
                                    <StackPanel>
                                        <TextBlock Text="Treble Tamer" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Soften bright tracks" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolMacroButton}"
                                        Command="{Binding AddGamingClarityCommand}"
                                        Click="ToolMenuItem_Click"
                                        AutomationProperties.Name="Create a Gaming Clarity copy">
                                    <StackPanel>
                                        <TextBlock Text="Gaming Clarity" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Dialogue + footsteps" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="BAND MANAGEMENT" Style="{StaticResource ToolMenuSectionLabel}"/>

                            <UniformGrid Columns="2" Margin="2,0,2,4">
                                <Button Content="Enable all"
                                        Command="{Binding EnableAllBandsCommand}"
                                        Click="ToolMenuItem_Click"
                                        Style="{StaticResource QuietButton}"
                                        Margin="0,0,4,0"
                                        ToolTip="Turn every EQ band on"/>
                                <Button Content="Bypass all"
                                        Command="{Binding BypassAllBandsCommand}"
                                        Click="ToolMenuItem_Click"
                                        Style="{StaticResource QuietButton}"
                                        Margin="0"
                                        ToolTip="Temporarily turn every EQ band off"/>
                            </UniformGrid>

                            <Button Style="{StaticResource ToolActionButton}"
                                    Command="{Binding SortBandsByFrequencyCommand}"
                                    Click="ToolMenuItem_Click"
                                    AutomationProperties.Name="Sort bands by frequency">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#1512323A" CornerRadius="7">
                                        <Path Style="{StaticResource ToolGlyph}"
                                              Data="M 2,4 L 16,4 M 5,9 L 16,9 M 8,14 L 16,14"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Sort by frequency" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Reorder bands from low to high" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource ToolActionButton}"
                                    Command="{Binding ZeroAllGainsCommand}"
                                    Click="ToolMenuItem_Click"
                                    AutomationProperties.Name="Flatten all gains">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#1512323A" CornerRadius="7">
                                        <Path Style="{StaticResource ToolGlyph}"
                                              Data="M 2,9 L 16,9 M 5,5 L 5,13 M 13,5 L 13,13"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Flat EQ" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Reset bands and preamp to 0.0 dB" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <TextBlock Text="A/B COMPARE" Style="{StaticResource ToolMenuSectionLabel}"/>

                            <Border Margin="2,0,2,4"
                                    Padding="9"
                                    Background="{StaticResource WolfShellBrush}"
                                    BorderBrush="{StaticResource WolfLineSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding CompareStatus}"
                                               Foreground="{StaticResource WolfMutedBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="2,0,2,8"/>
                                    <UniformGrid Columns="3">
                                        <Button Content="Capture"
                                                Command="{Binding CaptureCompareCommand}"
                                                Click="ToolMenuItem_Click"
                                                Style="{StaticResource QuietButton}"
                                                Margin="0,0,4,0"
                                                ToolTip="Capture the current curve as the A/B reference"/>
                                        <Button Content="Swap"
                                                Command="{Binding SwapCompareCommand}"
                                                Click="ToolMenuItem_Click"
                                                IsEnabled="{Binding HasComparePreset}"
                                                Style="{StaticResource QuietButton}"
                                                Margin="0,0,4,0"
                                                ToolTip="Swap the editor curve and A/B reference"/>
                                        <Button Content="Clear"
                                                Command="{Binding ClearCompareCommand}"
                                                Click="ToolMenuItem_Click"
                                                IsEnabled="{Binding HasComparePreset}"
                                                Style="{StaticResource QuietButton}"
                                                Margin="0"
                                                ToolTip="Remove the comparison curve"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SAFETY &amp; DEVICE" Style="{StaticResource ToolMenuSectionLabel}"/>

                            <Button Style="{StaticResource ToolActionButton}"
                                    Command="{Binding ApplyAutoHeadroomCommand}"
                                    Click="ToolMenuItem_Click"
                                    AutomationProperties.Name="Optimize preamp headroom">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#1512323A" CornerRadius="7">
                                        <Path Style="{StaticResource ToolGlyph}"
                                              Stroke="{StaticResource WolfGreenBrush}"
                                              Data="M 2,13 L 5,10 L 8,12 L 12,6 L 16,8 M 2,16 L 16,16"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Optimize Headroom" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Match preamp to the strongest enabled boost" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource ToolActionButton}"
                                    Command="{Binding PrepareK13PresetCommand}"
                                    IsEnabled="{Binding SupportsK13PresetTools}"
                                    Click="ToolMenuItem_Click"
                                    AutomationProperties.Name="Create device copy">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#1512323A" CornerRadius="7">
                                        <Path Style="{StaticResource ToolGlyph}"
                                              Data="M 6,3 L 15,3 L 15,12 L 6,12 Z M 3,6 L 3,15 L 12,15"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Device Copy" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Map this curve to the device preset" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource ToolActionButton}"
                                    Command="{Binding SmoothK13PresetCommand}"
                                    IsEnabled="{Binding SupportsK13PresetTools}"
                                    Click="ToolMenuItem_Click"
                                    AutomationProperties.Name="Create smooth device copy">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#1512323A" CornerRadius="7">
                                        <Path Style="{StaticResource ToolGlyph}"
                                              Data="M 1,13 C 5,13 5,5 9,5 C 13,5 13,11 17,11"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Smooth Copy" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Create a gentler device-ready curve" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Border Height="1" Background="{StaticResource WolfLineBrush}" Margin="2,8,2,4"/>
                            <TextBlock Text="SHARE" Style="{StaticResource ToolMenuSectionLabel}"/>

                            <Button Style="{StaticResource ToolActionButton}"
                                    Command="{Binding CopyTuningCardCommand}"
                                    Click="ToolMenuItem_Click"
                                    AutomationProperties.Name="Copy tuning card">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#1512323A" CornerRadius="7">
                                        <Path Style="{StaticResource ToolGlyph}"
                                              Data="M 5,4 L 3,4 L 3,16 L 14,16 L 14,4 L 12,4 M 6,2 L 11,2 L 11,6 L 6,6 Z M 6,10 L 11,10 M 6,13 L 10,13"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Copy tuning card" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Copy a shareable setup summary" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource ToolActionButton}"
                                    Command="{Binding CopyTuningReportCommand}"
                                    Click="ToolMenuItem_Click"
                                    AutomationProperties.Name="Copy detailed tuning report">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="#1512323A" CornerRadius="7">
                                        <Path Style="{StaticResource ToolGlyph}"
                                              Data="M 4,2 L 13,2 L 17,6 L 17,17 L 4,17 Z M 13,2 L 13,6 L 17,6 M 7,10 L 14,10 M 7,13 L 14,13"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Copy detailed report" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Diagnostics, safety, and every band" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</UserControl>
