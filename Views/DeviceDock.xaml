<UserControl x:Class="WolfEQ.Views.DeviceDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:WolfEQ.Views"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="56"
             Foreground="{DynamicResource WolfTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Detect reads quiet while connected, accent-bordered while disconnected. -->
        <Style x:Key="DetectButton" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource WolfCyanDimBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SlotMenuItem" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <views:SameValueMultiConverter x:Key="SameValueMultiConverter"/>

        <!-- Connection line + dot: green when working, amber when it needs a look, grey when idle. -->
        <Style x:Key="ConnectionToneText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionTone}" Value="Active"><Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionTone}" Value="Attention"><Setter Property="Foreground" Value="{DynamicResource WolfWarningBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConnectionToneDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource WolfDimBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionTone}" Value="Active"><Setter Property="Fill" Value="{DynamicResource WolfGreenBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding ConnectionTone}" Value="Attention"><Setter Property="Fill" Value="{DynamicResource WolfWarningBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- USER slot rows: compact and full-contrast even while the device is unplugged
             (a hint above the list explains why switching is unavailable). -->
        <Style x:Key="SlotRowItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
                    </MultiTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <!-- Slot title: the local EQ name when there is one, otherwise "USER n". -->
        <Style x:Key="SlotTitleText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding LocalEqName}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LocalEqName}" Value="{x:Null}"><Setter Property="Text" Value="{Binding SlotLabel}"/></DataTrigger>
                <DataTrigger Binding="{Binding LocalEqName}" Value=""><Setter Property="Text" Value="{Binding SlotLabel}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Slot subtitle: "USER n" under a local name, otherwise a dim "No local name yet". -->
        <Style x:Key="SlotSubtitleText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding SlotLabel}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LocalEqName}" Value="{x:Null}"><Setter Property="Text" Value="{Binding LocalEqSubtitle}"/><Setter Property="Foreground" Value="{DynamicResource WolfDimBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding LocalEqName}" Value=""><Setter Property="Text" Value="{Binding LocalEqSubtitle}"/><Setter Property="Foreground" Value="{DynamicResource WolfDimBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}"
            Padding="0" Background="Transparent" BorderThickness="0"
            MinHeight="58">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Device switcher: quick list of System EQ and plugged-in FiiO devices, with Settings one click away. -->
            <Grid Grid.Column="0">
            <ToggleButton x:Name="DeviceMenuButton" Style="{StaticResource StudioMenuToggle}" Height="54" Padding="16,6"
                          Background="{DynamicResource WolfPanel2Brush}" BorderBrush="{DynamicResource WolfLineBrush}"
                          IsChecked="{Binding IsOpen, ElementName=DevicePopup, Mode=TwoWay}" Checked="DeviceMenuButton_Checked"
                          ToolTip="Switch device" AutomationProperties.Name="Switch device">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="DeviceProductImage" Source="{Binding SelectedDeviceProfile.ProductImagePath}" Width="48" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding SelectedDeviceProfile.DisplayName}"/>
                    <Ellipse x:Name="SyncStateDot" Width="9" Height="9" Style="{StaticResource ConnectionToneDot}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SelectedDeviceProfile.DisplayLabel}" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="ConnectionStatusText" Text="{Binding ConnectionText}" FontSize="12" Style="{StaticResource ConnectionToneText}" Margin="0,2,0,0"/></StackPanel>
                    <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource WolfMutedBrush}" StrokeThickness="1.5" Margin="22,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>
            <Popup x:Name="DevicePopup" PlacementTarget="{Binding ElementName=DeviceMenuButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" Closed="DevicePopup_Closed"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <Border Background="{DynamicResource WolfPanelBrush}" BorderBrush="{DynamicResource WolfLineSoftBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="6" Width="320" Effect="{StaticResource WolfComboShadow}" Margin="0,0,8,8">
                    <StackPanel>
                        <DockPanel Margin="12,8,12,6">
                            <TextBlock x:Name="DeviceScanText" DockPanel.Dock="Right" Text="Scanning..." Style="{StaticResource TinyLabel}"
                                       Visibility="{Binding IsScanningQuickDevices, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="DEVICES" Style="{StaticResource TinyLabel}"/>
                        </DockPanel>
                        <ItemsControl x:Name="DeviceItems" ItemsSource="{Binding QuickDevices}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Style="{StaticResource SlotMenuItem}" Click="DeviceMenuItem_Click" Margin="0,1"
                                        Command="{Binding DataContext.SwitchToQuickDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Image Source="{Binding ImagePath}" Width="40" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource WolfMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Path Grid.Column="2" Data="M0,5 L4,9 L12,0" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" Margin="10,0,4,0"
                                              Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Plug in a FiiO device to see it here." Style="{StaticResource TinyLabel}" Margin="12,6,12,4"
                                   Visibility="{Binding HasOnlySystemEqQuickDevice, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Border Height="1" Background="{DynamicResource WolfLineBrush}" Margin="6,6"/>
                        <Button x:Name="ManageDevicesButton" Style="{StaticResource SlotMenuItem}" Click="DeviceSettings_Click" AutomationProperties.Name="Manage devices">
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource WolfMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center"/>
                                <TextBlock Text="Manage devices..." Foreground="{DynamicResource WolfTextBrush}"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
            </Grid>

            <Rectangle Grid.Column="1"
                       Width="1"
                       Fill="{DynamicResource WolfLineSoftBrush}"
                       Margin="12,2"/>

            <!-- Menu entries invoke the existing guarded switch command. Selection
                 stays bound to the confirmed slot, including after cancellation. -->
            <!-- Hardware only: Windows System EQ has no USER slots. -->
            <Grid Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ToggleButton x:Name="SlotMenuButton" Style="{StaticResource StudioMenuToggle}" Height="54" Padding="16,6"
                              Background="{DynamicResource WolfPanel2Brush}" BorderBrush="{DynamicResource WolfLineBrush}"
                              IsChecked="{Binding IsOpen, ElementName=SlotPopup, Mode=TwoWay}"
                              MinWidth="150" AutomationProperties.Name="Choose USER slot" ToolTip="Switch saved device profile">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="132" VerticalAlignment="Center" ToolTip="{Binding SelectedDeviceUserPreset.LocalEqSubtitle}">
                            <TextBlock x:Name="SlotMenuTitle" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SelectedDeviceUserPreset.LocalEqName}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDeviceUserPreset.LocalEqName, FallbackValue={x:Null}}" Value="{x:Null}"><Setter Property="Text" Value="{Binding SelectedDeviceUserPreset.SlotLabel, FallbackValue=Choose slot, TargetNullValue=Choose slot}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedDeviceUserPreset.LocalEqName}" Value=""><Setter Property="Text" Value="{Binding SelectedDeviceUserPreset.SlotLabel}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="SlotMenuSubtitle" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SelectedDeviceUserPreset.SlotLabel}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
                                        <Style.Triggers>
                                            <!-- Unnamed: the title already says "USER n", so the subtitle says what is missing. -->
                                            <DataTrigger Binding="{Binding SelectedDeviceUserPreset.LocalEqName}" Value="{x:Null}"><Setter Property="Text" Value="{Binding SelectedDeviceUserPreset.LocalEqSubtitle}"/><Setter Property="Foreground" Value="{DynamicResource WolfDimBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedDeviceUserPreset.LocalEqName}" Value=""><Setter Property="Text" Value="{Binding SelectedDeviceUserPreset.LocalEqSubtitle}"/><Setter Property="Foreground" Value="{DynamicResource WolfDimBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource WolfMutedBrush}" StrokeThickness="1.5" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="SlotPopup" PlacementTarget="{Binding ElementName=SlotMenuButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" Closed="SlotPopup_Closed"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <Border Background="{DynamicResource WolfPanelBrush}" BorderBrush="{DynamicResource WolfLineSoftBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="6" Width="280" Effect="{StaticResource WolfComboShadow}" Margin="0,0,8,8">
                        <StackPanel>
                            <DockPanel Margin="10,8,10,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDeviceProfile.DisplayLabel}" Style="{StaticResource TinyLabel}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="12,0,0,0"/>
                                <TextBlock Text="USER SLOTS" Style="{StaticResource TinyLabel}"/>
                            </DockPanel>
                            <TextBlock x:Name="SlotConnectHint" Text="Connect the device to switch slots." FontSize="11" Foreground="{DynamicResource WolfWarningBrush}" Margin="10,0,10,6" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SlotItems" ItemsSource="{Binding DeviceUserPresets}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Style="{StaticResource SlotRowItem}" Click="SlotMenuItem_Click"
                                                Command="{Binding DataContext.SwitchSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding SlotLabel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" CornerRadius="5" Background="{DynamicResource WolfPanel2Brush}" BorderBrush="{DynamicResource WolfLineSoftBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Slot}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WolfMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding LocalEqSubtitle}">
                                                    <TextBlock Style="{StaticResource SlotTitleText}"/>
                                                    <TextBlock Style="{StaticResource SlotSubtitleText}"/>
                                                </StackPanel>
                                                <Path Grid.Column="2" Data="M0,5 L4,9 L12,0" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center" Margin="10,0,4,0">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True"><DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource SameValueMultiConverter}">
                                                                        <Binding Path="PresetId"/>
                                                                        <Binding Path="DataContext.SelectedDeviceUserPreset.PresetId" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Height="1" Background="{DynamicResource WolfLineBrush}" Margin="6,6"/>
                                <Button x:Name="NameSlotButton" Style="{StaticResource SlotRowItem}" Click="NameSlot_Click" AutomationProperties.Name="Name this slot">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource WolfMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="Name this slot..." FontSize="13" Foreground="{DynamicResource WolfTextBrush}"/>
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <TextBlock Grid.Column="3" Text="{Binding Bands.Count, StringFormat={}{0}-band PEQ}" Foreground="{DynamicResource WolfMutedBrush}" Margin="22,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SyncStateText" Grid.Column="4" Text="{Binding EditorSyncStatusText}" Visibility="Collapsed"/>
            <!-- 5. Live-sync toggle (only for profiles that support live EQ writes) -->
            <!-- 5b. System EQ: bypass in the live-sync column. The status line is the device button subtitle (ConnectionText), so it is not repeated here. -->
            <StackPanel x:Name="SystemEqDockPanel"
                        Grid.Column="5"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Visibility="{Binding IsSystemEqSelected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <ToggleButton Style="{StaticResource BandPowerToggle}"
                              IsChecked="{Binding SystemEqBypassed, Mode=TwoWay}"
                              AutomationProperties.Name="Bypass System EQ"
                              ToolTip="Turn off WolfEQ's effect without losing your EQ"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0"/>
                <TextBlock Text="Bypass" FontWeight="SemiBold"
                           Foreground="{DynamicResource WolfMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Column="5" Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Visibility="{Binding SelectedDeviceProfile.SupportsLiveEqWrites, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ToggleButton Style="{StaticResource BandPowerToggle}"
                              IsChecked="{Binding LiveDeviceEqSyncEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="Live sync"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0"/>
                <TextBlock Text="Live sync" FontWeight="SemiBold"
                           Foreground="{DynamicResource WolfMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <Button x:Name="LiveSyncHelp" Style="{StaticResource QuietButton}"
                        Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" Margin="4,0,0,0"
                        VerticalAlignment="Center" AutomationProperties.Name="About Live sync"
                        Click="LiveSyncHelp_Click" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                    <Button.ToolTip>
                        <ToolTip MaxWidth="300">
                            <StackPanel>
                                <TextBlock Text="Live sync" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="When on, EQ and preamp changes are sent to your connected device as you adjust them, so you can hear the result right away. When off, edits stay in the editor until you choose Write to save them to the selected USER slot. Requires a connected device that supports live EQ updates." TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <Grid Width="15" Height="15">
                        <Ellipse Stroke="{DynamicResource WolfMutedBrush}" StrokeThickness="1"/>
                        <TextBlock Text="?" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WolfMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
            </Grid>

            <!-- 6. Save to Library + Write; connection guidance stays in the Write tooltip. -->
            <StackPanel Grid.Column="6"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="SaveLibraryButton"
                        Click="SaveLibraryButton_Click"
                        Style="{StaticResource QuietButton}"
                        ToolTip="Name and save this EQ to My Library"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Path Data="M1,0 H13 V20 L7,15 L1,20 Z" Stroke="{DynamicResource WolfTextBrush}" StrokeThickness="1.5" Width="14" Height="20" Margin="0,0,12,0"/><TextBlock Text="Save to Library" FontSize="14" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Popup x:Name="SaveLibraryPopup" PlacementTarget="{Binding ElementName=SaveLibraryButton}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" Opened="SaveLibraryPopup_Opened" Closed="SaveLibraryPopup_Closed">
                    <Border Width="340" Padding="18" Background="{DynamicResource WolfPanelBrush}" BorderBrush="{DynamicResource WolfLineSoftBrush}" BorderThickness="1" CornerRadius="10" PreviewKeyDown="SaveLibraryPopup_KeyDown">
                        <StackPanel>
                            <TextBlock Text="Save to Library" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Keep this name to update the preset, or enter a new name to save a copy." TextWrapping="Wrap" Foreground="{DynamicResource WolfMutedBrush}" Margin="0,8,0,14"/>
                            <Label Content="Preset name" Target="{Binding ElementName=LibraryPresetName}" Padding="0,0,0,5"/>
                            <TextBox x:Name="LibraryPresetName" AutomationProperties.Name="Preset name"/>
                            <TextBlock x:Name="LibrarySaveError" Foreground="{DynamicResource WolfWarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="Cancel" Style="{StaticResource QuietButton}" Click="CancelLibrarySave_Click"/>
                                <Button Content="Save" Style="{StaticResource SavePresetButton}" Click="ConfirmLibrarySave_Click" MinWidth="80"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="WriteToDeviceButton" Command="{Binding WriteToDeviceCommand}"
                        Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTipService.ShowOnDisabled="True"
                        Style="{StaticResource SavePresetButton}" Height="54" MinWidth="190"
                        ToolTip="Write the editor's EQ to the device slot"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Path Data="M9,0 V12 M4,7 L9,12 L14,7 M1,13 V18 H17 V13" Stroke="{DynamicResource WolfGreenContrastBrush}" StrokeThickness="1.7" Width="18" Height="20" Margin="0,0,12,0"/><TextBlock Foreground="{DynamicResource WolfGreenContrastBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="Write to "/><Run Text="{Binding SelectedDeviceUserPreset.DeviceName, Mode=OneWay, FallbackValue=device, TargetNullValue=device}"/></TextBlock></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
