<Window x:Class="WolfEQ.Views.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WolfEQ quick profiles" Width="368" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">
    <Window.Resources>
        <Style x:Key="TrayButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="Background" Value="#20262B"/>
            <Setter Property="BorderBrush" Value="#35424A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#263C43"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WolfCyanBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WolfCyanBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#16414A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" BorderThickness="1" BorderBrush="#3A4D55" Padding="20" Margin="4">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#17252B" Offset="0"/><GradientStop Color="#121619" Offset="0.6"/></LinearGradientBrush></Border.Background>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="/WolfEQ;component/Assets/icon/wolfeq.png" Width="36" Height="36" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1"><TextBlock Text="WOLF EQ" FontSize="20" FontWeight="Bold"/><TextBlock Text="YOUR SOUND. ONE CLICK AWAY." FontSize="9" Foreground="{StaticResource WolfCyanBrush}" Margin="0,3,0,0"/></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Vm.AppVersionText}" FontSize="10" VerticalAlignment="Top" Foreground="{StaticResource WolfMutedBrush}"/>
            </Grid>
            <Border Background="#151F24" CornerRadius="9" Padding="12" Margin="0,0,0,16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Margin="0,0,10,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource WolfDimBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Vm.IsDeviceConnected}" Value="True"><Setter Property="Fill" Value="{StaticResource WolfGreenBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Vm.DeviceNickname}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ConnectionSummary}" Foreground="{StaticResource WolfMutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="QUICK PROFILES" FontSize="10" Foreground="{StaticResource WolfCyanBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="Switch the profiles stored on your device." FontSize="11" Foreground="{StaticResource WolfMutedBrush}" Margin="0,0,0,12"/>
            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Click="OnSlotClick" Tag="{Binding Slot}" Margin="0,0,6,6" IsEnabled="{Binding DataContext.CanSwitch, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TrayButton}"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/><Setter Property="Background" Value="#12312B"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            <StackPanel><TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" FontSize="9" Foreground="{StaticResource WolfMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ProgressBar Height="2" IsIndeterminate="True" Foreground="{StaticResource WolfCyanBrush}" Margin="0,5,0,8"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource WolfMutedBrush}" TextWrapping="Wrap" MaxHeight="90" ToolTip="{Binding Message}" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
            <Border BorderBrush="#2D3A40" BorderThickness="0,1,0,0" Padding="0,13,0,0">
                <StackPanel>
                    <CheckBox Content="Close to tray" IsChecked="{Binding Preferences.CloseToTray}" Margin="0,0,0,8" Foreground="{StaticResource WolfTextBrush}" FontSize="12"/>
                    <CheckBox Content="Minimize to tray" IsChecked="{Binding Preferences.MinimizeToTray}" Margin="0,0,0,14" Foreground="{StaticResource WolfTextBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding Preferences.SaveError}" Foreground="{StaticResource WolfWarningBrush}" FontSize="10" TextWrapping="Wrap"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource TrayButton}" Content="Open editor" Click="OnOpenEditor" HorizontalContentAlignment="Center" Background="#16434C"/>
                        <Button Grid.Column="1" Style="{StaticResource TrayButton}" Content="Settings" Click="OnOpenSettings" Margin="6,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource TrayButton}" Content="Quit" Click="OnQuit" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
