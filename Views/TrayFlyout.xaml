<Window x:Class="WolfEQ.Views.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WolfEQ.Controls"
        xmlns:views="clr-namespace:WolfEQ.Views"
        Title="WolfEQ quick profiles" Width="368" SizeToContent="Height" Icon="/WolfEQ;component/Assets/icon/wolfeq.ico"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">
    <!-- Local resources live on the root card (not Window.Resources) so the rendered
         surface keeps them when tests detach the content from the window. -->
    <Border x:Name="FlyoutCard" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource WolfLineSoftBrush}" Background="{DynamicResource WolfPanelBrush}" Margin="4">
        <Border.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <views:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <!-- Row button: quiet surface, stretched content, accent when IsActive/IsCurrent. -->
            <Style x:Key="TrayRowButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
                <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            </Style>
            <Style x:Key="TrayFooterButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
            </Style>
            <Style x:Key="ToneDot" TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource WolfDimBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Vm.ConnectionTone, FallbackValue=Idle}" Value="Active"><Setter Property="Fill" Value="{DynamicResource WolfGreenBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Vm.ConnectionTone, FallbackValue=Idle}" Value="Attention"><Setter Property="Fill" Value="{DynamicResource WolfWarningBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ToneText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Vm.ConnectionTone, FallbackValue=Idle}" Value="Active"><Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Vm.ConnectionTone, FallbackValue=Idle}" Value="Attention"><Setter Property="Foreground" Value="{DynamicResource WolfWarningBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Resources>
        <!-- DockPanel measures the footer first, so it always gets its full height and the body scrolls. -->
        <DockPanel LastChildFill="True">
            <!-- 5. Footer: actions + tucked-away tray options -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="OpenEditorButton" Click="OnOpenEditor" AutomationProperties.Name="Open editor" ToolTip="Open the WolfEQ editor"
                                Style="{StaticResource TrayFooterButton}" Background="{DynamicResource WolfAccentHoverBrush}" BorderBrush="{DynamicResource WolfGreenBrush}" Foreground="{DynamicResource WolfTextBrush}">
                            <StackPanel Orientation="Horizontal">
                                <controls:PhosphorIcon IconName="SlidersHorizontal" IconSize="15" IconBrush="{DynamicResource WolfGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Open editor" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Grid.Column="1" Click="OnOpenSettings" AutomationProperties.Name="Settings" ToolTip="Settings"
                                Style="{StaticResource TrayFooterButton}" Width="38" Padding="0" Margin="6,0,0,0">
                            <controls:PhosphorIcon IconName="Gear" IconSize="16" IconBrush="{DynamicResource WolfMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="QuitButton" Grid.Column="2" Click="OnQuit" AutomationProperties.Name="Quit" ToolTip="Quit WolfEQ"
                                Style="{StaticResource TrayFooterButton}" Width="38" Padding="0" Margin="6,0,0,0">
                            <controls:PhosphorIcon IconName="Power" IconSize="16" IconBrush="{DynamicResource WolfMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                    <ToggleButton x:Name="TrayOptionsToggle" Checked="OnTrayOptionsToggled" Unchecked="OnTrayOptionsToggled" Margin="0,8,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Tray options" Cursor="Hand"
                                  Foreground="{DynamicResource WolfDimBrush}" Background="Transparent">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" Padding="2,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Label" Text="Tray options" FontSize="11" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                        <Path x:Name="Chevron" Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/></Trigger>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M0,4 L4,0 L8,4"/><Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <StackPanel x:Name="TrayOptionsPanel" Margin="2,8,0,0" Visibility="Collapsed">
                        <CheckBox Content="Close to tray" IsChecked="{Binding Preferences.CloseToTray}" Margin="0,0,0,6" Foreground="{DynamicResource WolfTextBrush}" FontSize="12"/>
                        <CheckBox Content="Minimize to tray" IsChecked="{Binding Preferences.MinimizeToTray}" Foreground="{DynamicResource WolfTextBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Preferences.SaveError}" Foreground="{DynamicResource WolfWarningBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding Preferences.SaveError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding Preferences.SaveError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Everything above the footer scrolls as one, so short work areas never overlap rows. -->
            <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,14,16,4">
                    <!-- 1. Brand + version -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Viewbox Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Canvas Width="64" Height="64" Background="Transparent">
                                <Path Data="M0,18 L5,18 L9,7 L13,30 L18,0 L23,36 L28,12 L32,23 L37,18" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Canvas.Left="6.1" Canvas.Top="6.8"><Path.RenderTransform><ScaleTransform ScaleX="1.4" ScaleY="1.4"/></Path.RenderTransform></Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Text="WolfEQ" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Vm.AppVersionText}" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 2. Device row (matches the dock's device switcher) -->
                    <Grid x:Name="DeviceRow" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="52" Height="42" CornerRadius="9" Background="{DynamicResource WolfShellBrush}" Margin="0,0,12,0">
                            <Image Source="{Binding Vm.SelectedDeviceProfile.ProductImagePath}" Width="42" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{Binding Vm.SelectedDeviceProfile.DisplayName}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceTitleText" Text="{Binding DeviceTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse x:Name="ToneDotEllipse" Width="7" Height="7" Style="{StaticResource ToneDot}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                <TextBlock x:Name="DeviceStatusText" Text="{Binding Vm.ConnectionText}" FontSize="11" Style="{StaticResource ToneText}" TextTrimming="CharacterEllipsis" MaxWidth="248" ToolTip="{Binding Vm.ConnectionText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 3. Now playing -->
                    <Border x:Name="NowPlayingCard" Background="{DynamicResource WolfShellBrush}" BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,11" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource WolfAccentHoverBrush}" BorderBrush="{DynamicResource WolfLineSoftBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <controls:PhosphorIcon IconName="MusicNote" IconSize="18" IconBrush="{DynamicResource WolfGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="Now playing" Style="{StaticResource TinyLabel}"/>
                                <TextBlock x:Name="NowPlayingTitle" Text="{Binding NowTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding NowTitle}"/>
                                <TextBlock x:Name="NowPlayingSubtitle" Text="{Binding NowSubtitle}" FontSize="11" Foreground="{DynamicResource WolfMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding NowSubtitle}"/>
                            </StackPanel>
                            <!-- Software EQ only: ON means "not bypassed". -->
                            <StackPanel x:Name="EqSwitchPanel" Grid.Column="2" VerticalAlignment="Center"
                                        Visibility="{Binding Vm.IsSystemEqSelected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                <TextBlock Text="EQ" Style="{StaticResource TinyLabel}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <ToggleButton x:Name="EqToggle" Style="{StaticResource BandPowerToggle}" Focusable="True"
                                              IsChecked="{Binding Vm.SystemEqBypassed, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}"
                                              AutomationProperties.Name="Software EQ on" ToolTip="Turn Software EQ on or off"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hint: its own row above the list, never on top of it. -->
                    <Border x:Name="HintRow" Background="{DynamicResource WolfPanel2Brush}" CornerRadius="7" Padding="10,7" Margin="0,0,0,10">
                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                            <DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding Vm.IsSystemEqSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <DockPanel>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource WolfWarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="HintText" Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Message}" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ProgressBar Height="2" IsIndeterminate="True" Foreground="{DynamicResource WolfCyanBrush}" Background="Transparent" BorderThickness="0" Margin="0,0,0,8"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Vm.IsSystemEqSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>

                    <!-- 4a. Hardware: USER slot chips -->
                    <StackPanel x:Name="SlotsPanel" Visibility="{Binding Vm.IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Device presets" Style="{StaticResource TinyLabel}" Margin="2,0,0,7"/>
                        <ItemsControl ItemsSource="{Binding Slots}" Margin="0,0,-6,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Click="OnSlotClick" Tag="{Binding Slot}" Margin="0,0,6,6" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}"
                                        IsEnabled="{Binding DataContext.CanSwitch, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TrayRowButton}"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/><Setter Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource WolfMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Path Grid.Column="1" Data="M0,5 L4,9 L12,0" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 4b. Software EQ: quick presets from the library -->
                    <StackPanel x:Name="QuickPresetsPanel" Visibility="{Binding Vm.IsSystemEqSelected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="Quick presets" Style="{StaticResource TinyLabel}" Margin="2,0,0,7"/>
                        <ItemsControl x:Name="QuickPresetItems" ItemsSource="{Binding QuickPresets}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Click="OnQuickPresetClick" Margin="0,0,0,5" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TrayRowButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/><Setter Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource WolfShellBrush}" VerticalAlignment="Center">
                                            <controls:PhosphorIcon IconName="{Binding IconName}" IconSize="14" IconBrush="{DynamicResource WolfGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource WolfMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Path Grid.Column="2" Data="M0,5 L4,9 L12,0" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" Margin="0,0,2,0" Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Save a preset in the library to see it here." Style="{StaticResource DimText}" Margin="2,0,0,6"
                                   Visibility="{Binding HasNoQuickPresets, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
