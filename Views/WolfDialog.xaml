<Window x:Class="WolfEQ.Views.WolfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource WolfTextBrush}"
        KeyDown="Window_KeyDown">
    <!-- Full-window dim layer over the owner; the card is the dialog itself. -->
    <Grid x:Name="Scrim" Background="#99000000" MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
        <Border x:Name="Card"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource WolfPanelBrush}"
                BorderBrush="{DynamicResource WolfLineSoftBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22,20,22,18"
                MouseLeftButtonDown="Card_MouseLeftButtonDown"
                Effect="{StaticResource WolfComboShadow}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" Background="#26FF5555">
                        <Path x:Name="IconPath" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="290"/>
                </StackPanel>
                <TextBlock x:Name="MessageText" Style="{StaticResource DimText}" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                <TextBlock x:Name="DetailText" FontSize="12" Foreground="{DynamicResource WolfMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                <!-- Text prompt mode (rename): input plus a live validation message. -->
                <StackPanel x:Name="PromptPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBox x:Name="PromptBox" Height="38" Padding="10,0" FontSize="13" TextChanged="PromptBox_TextChanged" AutomationProperties.Name="New name"/>
                    <TextBlock x:Name="PromptError" FontSize="12" Foreground="{DynamicResource WolfWarningBrush}" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource QuietButton}" Padding="16,8" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton" Padding="16,8" Click="ConfirmButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfTextBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
