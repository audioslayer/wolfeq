                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}"
                                                            Click="KnobLedMode_Click"
                                                            Style="{StaticResource QuietButton}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Presets"
                                       Style="{StaticResource TinyLabel}"
                                       Margin="0,14,0,8"/>
                            <ItemsControl ItemsSource="{Binding LedSceneOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}"
                                                Click="LedScene_Click"
                                                Style="{StaticResource QuietButton}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Windows Audio" Tag="SpeakerHigh" HeaderTemplate="{StaticResource SettingsSectionHeader}"
                              IsExpanded="False"
                              Foreground="{DynamicResource WolfMutedBrush}"
                              Expanded="WindowsAudioExpander_Expanded"
                              Margin="0,0,0,10">
                        <StackPanel Margin="0,10,0,0">
                            <Border Padding="13,12"
                                    Background="{DynamicResource WolfShellBrush}"
                                    BorderBrush="{DynamicResource WolfLineSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Default format"
                                                       Style="{StaticResource TinyLabel}"/>
                                            <TextBlock Text="{Binding WindowsAudioCurrentFormat}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding WindowsAudioFormatStatus}"
                                                       Style="{StaticResource DimText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,12,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Command="{Binding RefreshWindowsAudioFormatsCommand}"
                                                Style="{StaticResource QuietButton}"
                                                Padding="10,7"
                                                VerticalAlignment="Top"
                                                ToolTip="Rescan the Windows default output">
                                            <controls:PhosphorIcon IconName="ArrowClockwise"
                                                                   IconSize="15"
                                                                   IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding WindowsAudioQuickFormats}"
                                                  Margin="-4,12,-4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ApplyWindowsAudioQuickFormatCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsSupported}"
                                                        Height="48"
                                                        Margin="4,0"
                                                        Padding="5"
                                                        ToolTip="Apply this format to the Windows default output">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="CURRENT"
                                                                   FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource WolfGreenBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Padding="13,12"
                                    Margin="0,8,0,0"
                                    Background="{DynamicResource WolfShellBrush}"
                                    BorderBrush="{DynamicResource WolfLineSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Spatial sound"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Windows Sonic, Dolby Atmos, or DTS"
                                                   Style="{StaticResource DimText}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Manage"
                                            Command="{Binding OpenWindowsOutputSettingsCommand}"
                                            Style="{StaticResource AccentButton}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Padding="10,8"
                                    Margin="0,8,0,0"
                                    Background="{DynamicResource WolfPanel2Brush}"
                                    CornerRadius="8">
                                <TextBlock Text="Applies to the Windows default output. Unsupported formats stay disabled."
                                           Foreground="{DynamicResource WolfMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Integrations" Tag="Keyboard" HeaderTemplate="{StaticResource SettingsSectionHeader}" Margin="0,0,0,10">
                        <StackPanel Margin="4,10">
                            <TextBlock Text="Stream Deck" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Switch to an EQ already stored in a USER slot with one key press." Style="{StaticResource MutedText}" Margin="0,6,0,10"/>
                            <ToggleButton x:Name="StreamDeckSetupButton" Style="{StaticResource StudioMenuToggle}" IsChecked="{Binding IsOpen, ElementName=StreamDeckSetupPopup, Mode=TwoWay}" Margin="0,0,0,12" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal"><controls:PhosphorIcon IconName="Keyboard" IconSize="18" IconBrush="{DynamicResource WolfGreenBrush}" Margin="0,0,10,0"/><TextBlock Text="Windows ScriptDeck setup"/></StackPanel>
                            </ToggleButton>
                            <Popup x:Name="StreamDeckSetupPopup" PlacementTarget="{Binding ElementName=StreamDeckSetupButton}" Placement="Left" HorizontalOffset="-10" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Width="420" Padding="18" Background="{DynamicResource WolfPanelBrush}" BorderBrush="{DynamicResource WolfLineSoftBrush}" BorderThickness="1" CornerRadius="10" PreviewKeyDown="StreamDeckSetup_KeyDown">
                                    <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="&#x00D7;" Style="{StaticResource QuietButton}" Click="CloseStreamDeckSetup_Click" AutomationProperties.Name="Close Stream Deck setup"/><TextBlock Text="One-button EQ switching" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                            <TextBlock Text="1. Install Windows ScriptDeck" FontWeight="SemiBold"/>
                                            <TextBlock Text="Get the Windows ScriptDeck plugin by Start-Automating from Elgato Marketplace." TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,5,0,8"/>
                                            <Button Content="Open plugin in Marketplace" Command="{Binding OpenWindowsScriptDeckCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="2. Choose the USER slot" FontWeight="SemiBold" Margin="0,16,0,6"/>
                                            <ComboBox ItemsSource="{Binding IntegrationSlots}" SelectedItem="{Binding IntegrationSlot}" AutomationProperties.Name="Stream Deck USER slot"/>
                                            <TextBlock Text="{Binding StreamDeckSetupNote}" TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,6,0,8"/>
                                            <TextBlock Text="3. Paste into On Press" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                            <TextBlock Text="Add the plugin's script action to a Stream Deck key. Copy the script below into its On Press field, then name your key. Repeat with a different slot for each EQ." TextWrapping="Wrap" Style="{StaticResource DimText}"/>
                                            <TextBox Text="{Binding StreamDeckPowerShell, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="0,10,0,8" AutomationProperties.Name="PowerShell script for Windows ScriptDeck"/>
                                            <Button Content="Copy PowerShell script" Command="{Binding CopyStreamDeckPowerShellCommand}" Style="{StaticResource SavePresetButton}"/>
                                            <TextBlock Text="{Binding StreamDeckCopyStatus}" TextWrapping="Wrap" Foreground="{DynamicResource WolfGreenBrush}" Margin="0,6,0,0"/>
                                            <TextBlock Text="Uses your WolfEQ location and saved USB device automatically. Recopy the script if either changes." TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,10,0,0"/>
                                            <TextBlock Text="Switches an EQ already stored on the device. Save or discard editor changes first. For matching LED colors, enable automatic slot lighting and save a Bluetooth connection." TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <TextBlock Text="USER slot"/>
                            <ComboBox ItemsSource="{Binding IntegrationSlots}" SelectedItem="{Binding IntegrationSlot}" Margin="0,4,0,8"/>
                            <TextBox Text="{Binding StreamDeckCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <WrapPanel>
                                <Button Style="{StaticResource SettingsActionButton}" Tag="AppWindow" Content="Copy command" Command="{Binding CopyStreamDeckCommand}"/>
                                <Button Style="{StaticResource SettingsPrimaryButton}" Tag="Folder" Content="Save shortcut..." Command="{Binding SaveStreamDeckShortcutCommand}"/>
                            </WrapPanel>
                            <Expander Header="Setup &amp; troubleshooting" Margin="0,10,0,0"><StackPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,10" Text="1. In Device > Connections, save the intended USB and Bluetooth connection.&#10;2. Choose a USER slot above and click Save shortcut.&#10;3. In Stream Deck, drag System > Open onto a key.&#10;4. Choose the saved .lnk shortcut in App / File and name the key for your headphones.&#10;5. Repeat for each headphone EQ slot."/>
                            <TextBlock Text="Works with WolfEQ open or closed without bringing the editor forward. Use a current Stream Deck release that supports shortcut arguments. Recreate shortcuts if you move WolfEQ or change the device connection." Style="{StaticResource DimText}" Margin="0,4"/>
                            <TextBlock Text="Save or discard unsaved editor changes before using a key. Commands never overwrite a slot with a library preset. Lighting follows the slot when enabled in Profile Lights." Style="{StaticResource DimText}" Margin="0,4"/>
                            <TextBlock Text="Troubleshooting: the latest command result is in %LOCALAPPDATA%\WolfEQ\automation-result.json. For scripts: --help and --list-devices. Exit codes: 0 success, 1 failure, 2 invalid arguments, 3 busy or unsaved edits, 4 slot switched but lighting failed." Style="{StaticResource DimText}" Margin="0,4"/>
                            </StackPanel></Expander>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Appearance" Tag="Palette" HeaderTemplate="{StaticResource SettingsSectionHeader}"
                              IsExpanded="False"
                              Foreground="{DynamicResource WolfMutedBrush}"
                              Margin="0,0,0,10">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Background" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding BackgroundModes}" SelectedItem="{Binding SelectedBackgroundMode}" AutomationProperties.Name="Background mode" Margin="0,0,0,8"/>
                            <TextBlock Text="Choose light or dark surfaces. Your accent palette works with either." Style="{StaticResource DimText}" Margin="0,0,0,18"/>
                            <TextBlock Text="Accent theme"
                                       Style="{StaticResource TinyLabel}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Choose a solid color or a multicolor palette." TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding AccentColorOptions}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="AccentColorSwatch_Click"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,8,8"
                                                Padding="0"
                                                Cursor="Hand"
                                                ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                Background="Transparent"
                                                BorderBrush="Transparent">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Grid Width="44" Height="44">
                                                        <Border x:Name="SelectionRing"
                                                                Width="42"
                                                                Height="42"
                                                                CornerRadius="21"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                        <Border x:Name="Dot"
                                                                Width="34"
                                                                Height="34"
                                                                CornerRadius="17"
                                                                Background="{Binding Brush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Dot" Property="Opacity" Value="0.82"/>
                                                        </Trigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.SelectedAccentColorOption"
                                                                             RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource WolfTextBrush}"/>
                                                            <Setter TargetName="SelectionRing" Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SelectedAccentColorOption.Name}" FontWeight="SemiBold" Foreground="{DynamicResource WolfGreenBrush}"/>
                            <TextBlock Text="{Binding SelectedAccentColorOption.Description}" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="About" Tag="AppWindow" HeaderTemplate="{StaticResource SettingsSectionHeader}"
                              IsExpanded="False"
                              Foreground="{DynamicResource WolfMutedBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                <Button Style="{StaticResource SettingsActionButton}" Tag="ArrowRight" Content="Releases"
                                        Command="{Binding OpenReleasesCommand}"

                                        DockPanel.Dock="Right"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="WolfEQ"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AppVersionText}"
                                               Style="{StaticResource DimText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource SettingsActionButton}" Tag="Cloud" Grid.Column="1"
                                        Content="Check for Updates"
                                        Command="{Binding CheckForUpdatesCommand}"

                                        VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{Binding UpdateStatus}"
                                       Style="{StaticResource DimText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Button x:Name="DiscordChannelButton" Command="{Binding OpenDiscordCommand}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,0,10" ToolTip="Open the WolfEQ app channel in Discord" AutomationProperties.Name="Open WolfEQ Discord channel">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource WolfAccentHoverBrush}" CornerRadius="10" Margin="0,0,12,0">
                                        <Path Data="{StaticResource DiscordLogoGeometry}" Fill="{DynamicResource WolfGreenBrush}" Width="26" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="WolfEQ on Discord" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Open our app channel" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Path Grid.Column="2" Data="M2,12 L12,2 M4,2 H12 V10" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding OpenBuyMeCoffeeCommand}"
                                    Style="{StaticResource QuietButton}"
                                    HorizontalAlignment="Left"
                                    ToolTip="buymeacoffee.com/audioslayer">
                                <StackPanel Orientation="Horizontal">
                                    <controls:PhosphorIcon IconName="Heart"
                                                           IconSize="15"
                                                           IconBrush="{DynamicResource WolfMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="Buy me a coffee"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
