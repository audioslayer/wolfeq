    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,16,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36"
                        Height="36"
                        Background="{DynamicResource WolfAccentHoverBrush}"
                        BorderBrush="{DynamicResource WolfGreenBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <controls:PhosphorIcon IconName="Gear"
                                           IconSize="18"
                                           IconBrush="{DynamicResource WolfGreenBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Settings"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                </StackPanel>
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Style="{StaticResource OverlayCloseButton}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        ToolTip="Close settings"
                        Click="CloseButton_Click">
                    <Path Width="11"
                          Height="11"
                          Data="M 1,1 L 10,10 M 10,1 L 1,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Margin="12,0"
                    Background="{DynamicResource WolfLineBrush}"/>

            <ScrollViewer Grid.Row="2"
                          Margin="10,10,6,10"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="2,0,4,0">

                    <Expander Header="Device" Tag="Cpu" HeaderTemplate="{StaticResource SettingsSectionHeader}" IsExpanded="True" Margin="0,0,0,8">
 <StackPanel Margin="0,10,0,0">
 <DockPanel Margin="0,0,0,10">
 <Button Command="{Binding ConnectCommand}" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" ToolTip="Reconnect device" AutomationProperties.Name="Reconnect device" Width="30" Height="28" MinHeight="0" Padding="0" Margin="0">
 <Path Data="M16,6 A7,7 0 1 0 17,12 M16,1 V6 H11" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource WolfMutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
 </Button>
 <StackPanel><TextBlock Text="{Binding DeviceNickname}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionText}" Style="{StaticResource DimText}" Margin="0,2,0,0"/></StackPanel>
 </DockPanel>
 <TabControl Style="{StaticResource SettingsTabs}">
 <TabItem Tag="Link" Header="Connections" Style="{StaticResource SettingsTab}"><StackPanel Margin="0,10,0,0" IsEnabled="{Binding IntegrationControlsEnabled}">
                            <TextBlock Text="{Binding DeviceBindingSummary}" Style="{StaticResource DimText}" Margin="2,0,2,10"/>
                            <Grid Margin="2,0,2,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Device name" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" Text="{Binding DeviceNickname, UpdateSourceTrigger=PropertyChanged}" Padding="10,6" MinHeight="32" ToolTip="A friendly name for this saved connection"/>
                            </Grid>
                            <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <Button Style="{StaticResource SettingsActionButton}" Tag="MagnifyingGlass" Content="Refresh" DockPanel.Dock="Right" Command="{Binding RefreshUsbDevicesCommand}" Padding="10,4" MinHeight="28" Margin="8,0,0,0" ToolTip="Look for connected USB devices"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="USB" FontWeight="SemiBold"/>
                                            <TextBlock Text="Equalizer &amp; USER slots" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <ComboBox ItemsSource="{Binding UsbDevices}" SelectedItem="{Binding SelectedUsbDevice}" ToolTip="{Binding SelectedUsbDevice.Path}" MinHeight="34">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="305" ToolTip="{Binding Path}"/></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="Select a USB device" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource WolfDimBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedUsbDevice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <Button Style="{StaticResource SettingsActionButton}" Tag="WifiHigh" Content="Scan" DockPanel.Dock="Right" Command="{Binding ScanBluetoothDevicesCommand}" Padding="10,4" MinHeight="28" Margin="8,0,0,0" ToolTip="Scan for nearby K13 devices (8 seconds)"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Bluetooth" FontWeight="SemiBold"/>
                                            <TextBlock Text="Lights &amp; device controls" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <ComboBox ItemsSource="{Binding BluetoothDevices}" SelectedItem="{Binding SelectedBluetoothDevice}" MinHeight="34">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="305" ToolTip="{Binding Details}"/></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="Select a Bluetooth device" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource WolfDimBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedBluetoothDevice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <DockPanel LastChildFill="True" Margin="0,8,0,0">
                                        <Button Style="{StaticResource SettingsActionButton}" Tag="Lightbulb" Content="Identify" DockPanel.Dock="Right" Command="{Binding IdentifyBluetoothDeviceCommand}" Padding="10,4" MinHeight="28" Margin="8,0,0,0" ToolTip="Briefly turn the selected unit's lights green, then restore them"/>
                                        <TextBlock Text="Check this is your USB-connected unit." Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <DockPanel LastChildFill="True" Margin="2,0">
                                <Button Style="{StaticResource SettingsPrimaryButton}" Tag="Link" Content="Save connection" DockPanel.Dock="Right" Command="{Binding SaveDeviceBindingCommand}" Padding="12,6" Margin="10,0,0,0"/>
                                <TextBlock Text="Only these devices will be used." Style="{StaticResource DimText}" VerticalAlignment="Center" ToolTip="WolfEQ never falls back to another unit. If changing USB ports changes the device identity, select it again here."/>
                            </DockPanel>
                        <Expander Header="Model &amp; compatibility" Margin="0,12,0,0">
 <StackPanel Margin="0,8,0,0">
 <ComboBox ItemsSource="{Binding DeviceProfiles}" SelectedItem="{Binding SelectedDeviceProfile}" TextSearch.TextPath="DisplayLabel">
     <ComboBox.ItemTemplate>
         <DataTemplate>
             <StackPanel Orientation="Horizontal">
                 <Image Source="{Binding ProductImagePath}" Width="40" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                 <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"/>
             </StackPanel>
         </DataTemplate>
     </ComboBox.ItemTemplate>
 </ComboBox>
 <TextBlock Text="{Binding DeviceProfileCapabilityText}" Style="{StaticResource DimText}" Margin="0,6,0,0"/>
 <TextBlock Text="K13 PEQ: up to 192 kHz / 24-bit PCM. MQA is unavailable while EQ is active; switching EQ may briefly reconnect USB." Style="{StaticResource DimText}" Margin="0,6,0,0" Visibility="{Binding IsK13R2RSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
 </StackPanel>
 </Expander></StackPanel></TabItem>
 <TabItem Tag="SlidersHorizontal" Header="Controls" Style="{StaticResource SettingsTab}"><StackPanel Margin="0,12,0,0">
 <DockPanel Margin="0,0,0,10">
 <Button Style="{StaticResource SettingsActionButton}" Tag="MagnifyingGlass" Content="Refresh" Command="{Binding ReadDeviceControlsCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
 <TextBlock Text="Playback" FontWeight="SemiBold" VerticalAlignment="Center"/>
 </DockPanel>
 <Grid Margin="0,0,0,12" IsEnabled="{Binding SelectedDeviceSupportsBleInput}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock Text="Input" VerticalAlignment="Center"/>
 <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceInputSources}" SelectedItem="{Binding SelectedDeviceInputSource}" DisplayMemberPath="DisplayName"/>
 <StackPanel Grid.Column="2" Orientation="Horizontal">
 <Button Command="{Binding ReadInputSourceCommand}" Style="{StaticResource QuietButton}" Margin="6,0,0,0" Padding="6" ToolTip="Read current input"><controls:PhosphorIcon IconName="MagnifyingGlass" IconSize="14" IconBrush="{DynamicResource WolfMutedBrush}"/></Button>
 <Button Style="{StaticResource SettingsPrimaryButton}" Tag="ArrowRight" Content="Apply" Command="{Binding SetInputSourceCommand}" Margin="2,0,0,0"/>
 </StackPanel>
 </Grid>
 <StackPanel IsEnabled="{Binding SelectedDeviceSupportsBleDeviceControls}">
<DockPanel Margin="0,4,0,0"><TextBlock Text="{Binding DeviceVolume}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource WolfTextBrush}"/><TextBlock Text="Volume" Foreground="{DynamicResource WolfMutedBrush}"/></DockPanel>
 <controls:StyledSlider Minimum="0" Maximum="99" Value="{Binding DeviceVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Step="1" AccentColor="{DynamicResource WolfGreen}" ShowLabel="False"  Margin="0,0,0,6"/>
<DockPanel Margin="0,4,0,0"><TextBlock Text="{Binding DeviceVolumeLimit}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource WolfTextBrush}"/><TextBlock Text="Volume limit" Foreground="{DynamicResource WolfMutedBrush}"/></DockPanel>
 <controls:StyledSlider Minimum="0" Maximum="99" Value="{Binding DeviceVolumeLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Step="1" AccentColor="{DynamicResource WolfGreen}" ShowLabel="False"  Margin="0,0,0,6"/>
<DockPanel Margin="0,4,0,0"><TextBlock Text="{Binding DeviceChannelBalanceDisplay}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource WolfTextBrush}"/><TextBlock Text="Balance" Foreground="{DynamicResource WolfMutedBrush}"/></DockPanel>
 <controls:StyledSlider Minimum="-10" Maximum="10" Value="{Binding DeviceChannelBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Step="1" AccentColor="{DynamicResource WolfGreen}" ShowLabel="False" CenterOrigin="True" Margin="0,0,0,6"/>
<CheckBox Content="High gain" IsChecked="{Binding DeviceHighGain, Mode=TwoWay}" Margin="0,6,0,12"/>
 </StackPanel>
 <Border Height="1" Background="{DynamicResource WolfLineSoftBrush}" Margin="0,2,0,12"/>
 <TextBlock Text="Active slot name" Style="{StaticResource DimText}" Margin="0,0,0,6"/>
 <DockPanel>
 <Button Style="{StaticResource SettingsActionButton}" Tag="Keyboard" Content="Rename" Command="{Binding RenameUserSlotCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
 <TextBox Text="{Binding DeviceProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" ToolTip="Up to 8 characters"/>
 </DockPanel>
 <TextBlock Text="{Binding DeviceControlsStatus}" Style="{StaticResource DimText}" Margin="0,10,0,0"/>
 </StackPanel></TabItem>
 </TabControl>
 </StackPanel>
 </Expander>

                    <Expander Header="Profile Lights" Tag="Lightbulb" HeaderTemplate="{StaticResource SettingsSectionHeader}"
