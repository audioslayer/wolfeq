<UserControl x:Class="WolfEQ.Views.SettingsPopover"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WolfEQ"
             xmlns:controls="clr-namespace:WolfEQ.Controls"
             mc:Ignorable="d"
             d:DesignWidth="460"
             d:DesignHeight="820"
             Width="460"
             Foreground="{StaticResource WolfTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Copied from MainWindow resources; views keep their own converter copies. -->
        <local:ReferenceEqualsMultiConverter x:Key="ReferenceEqualsMultiConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,16,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36"
                        Height="36"
                        Background="{StaticResource WolfAccentHoverBrush}"
                        BorderBrush="#5500E676"
                        BorderThickness="1"
                        CornerRadius="9">
                    <controls:PhosphorIcon IconName="Gear"
                                           IconSize="18"
                                           IconBrush="{DynamicResource WolfGreenBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Settings"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Device, Windows audio, and app preferences"
                               Style="{StaticResource DimText}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Style="{StaticResource OverlayCloseButton}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        ToolTip="Close settings"
                        Click="CloseButton_Click">
                    <Path Width="11"
                          Height="11"
                          Data="M 1,1 L 10,10 M 10,1 L 1,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Margin="12,0"
                    Background="{StaticResource WolfLineBrush}"/>

            <ScrollViewer Grid.Row="2"
                          Margin="10,10,6,10"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="2,0,4,0">

                    <!-- 1. Theme: accent color swatches -->
                    <Expander Header="Theme"
                              IsExpanded="False"
                              Foreground="{StaticResource WolfMutedBrush}"
                              Margin="0,0,0,10">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Color"
                                       Style="{StaticResource TinyLabel}"
                                       Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AccentColorOptions}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="AccentColorSwatch_Click"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,8,8"
                                                Padding="0"
                                                Cursor="Hand"
                                                ToolTip="{Binding Name}"
                                                Background="Transparent"
                                                BorderBrush="Transparent">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Grid Width="44" Height="44">
                                                        <Border x:Name="SelectionRing"
                                                                Width="42"
                                                                Height="42"
                                                                CornerRadius="21"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                        <Border x:Name="Dot"
                                                                Width="34"
                                                                Height="34"
                                                                CornerRadius="17"
                                                                Background="{Binding Brush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Dot" Property="Opacity" Value="0.82"/>
                                                        </Trigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.SelectedAccentColorOption"
                                                                             RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource WolfTextBrush}"/>
                                                            <Setter TargetName="SelectionRing" Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- 2. Device: profile selection + detection (expanded by default) -->
                    <Expander Header="Device"
                              IsExpanded="True"
                              Foreground="{StaticResource WolfMutedBrush}"
                              Margin="0,0,0,10">
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel Margin="0,0,0,10">
                                <Button Content="Detect"
                                        Command="{Binding ConnectCommand}"
                                        Style="{StaticResource QuietButton}"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding ConnectionText}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <Border Style="{StaticResource SourceTileBorder}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Device profile" Style="{StaticResource TinyLabel}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding DeviceProfiles}"
                                              SelectedItem="{Binding SelectedDeviceProfile}"
                                              DisplayMemberPath="DisplayLabel"
                                              MinWidth="260"/>
                                    <TextBlock Text="{Binding DeviceSelectionStatus}"
                                               Style="{StaticResource DimText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding DeviceProfileCapabilityText}"
                                               Style="{StaticResource DimText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0"
                                    Padding="12,10"
                                    Background="{StaticResource WolfAccentHoverBrush}"
                                    CornerRadius="9"
                                    Visibility="{Binding IsK13R2RSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="K13 R2R PEQ behavior"
                                               Foreground="{DynamicResource WolfGreenBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Ten global PEQ bands work across USB, optical, coaxial, and Bluetooth. With PEQ active, FiiO limits playback to PCM 192 kHz/24-bit and MQA processing is unavailable. Switching EQ between Off and active can briefly reconnect USB."
                                               Style="{StaticResource DimText}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 3. Windows Audio: compact advanced controls for the default output -->
                    <Expander Header="Windows Audio"
                              IsExpanded="False"
                              Foreground="{StaticResource WolfMutedBrush}"
                              Expanded="WindowsAudioExpander_Expanded"
                              Margin="0,0,0,10">
                        <StackPanel Margin="0,10,0,0">
                            <Border Padding="13,12"
                                    Background="#B912171B"
                                    BorderBrush="{StaticResource WolfLineSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Default format"
                                                       Style="{StaticResource TinyLabel}"/>
                                            <TextBlock Text="{Binding WindowsAudioCurrentFormat}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding WindowsAudioFormatStatus}"
                                                       Style="{StaticResource DimText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,12,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Command="{Binding RefreshWindowsAudioFormatsCommand}"
                                                Style="{StaticResource QuietButton}"
                                                Padding="10,7"
                                                VerticalAlignment="Top"
                                                ToolTip="Rescan the Windows default output">
                                            <controls:PhosphorIcon IconName="ArrowClockwise"
                                                                   IconSize="15"
                                                                   IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding WindowsAudioQuickFormats}"
                                                  Margin="-4,12,-4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ApplyWindowsAudioQuickFormatCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsSupported}"
                                                        Height="48"
                                                        Margin="4,0"
                                                        Padding="5"
                                                        ToolTip="Apply this format to the Windows default output">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="CURRENT"
                                                                   FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource WolfGreenBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Padding="13,12"
                                    Margin="0,8,0,0"
                                    Background="#B912171B"
                                    BorderBrush="{StaticResource WolfLineSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Spatial sound"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Windows Sonic, Dolby Atmos, or DTS"
                                                   Style="{StaticResource DimText}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Manage"
                                            Command="{Binding OpenWindowsOutputSettingsCommand}"
                                            Style="{StaticResource AccentButton}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Padding="10,8"
                                    Margin="0,8,0,0"
                                    Background="{StaticResource WolfAccentHoverBrush}"
                                    CornerRadius="8">
                                <TextBlock Text="Applies to the Windows default output. Unsupported formats stay disabled."
                                           Foreground="{StaticResource WolfMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 4. Input: device input source -->
                    <Expander Header="Input"
                              IsExpanded="False"
                              Foreground="{StaticResource WolfMutedBrush}"
                              Margin="0,0,0,10"
                              IsEnabled="{Binding SelectedDeviceSupportsBleInput}">
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                <Button Content="Refresh"
                                        Command="{Binding ReadInputSourceCommand}"
                                        Style="{StaticResource QuietButton}"
                                        DockPanel.Dock="Right"/>
                            </DockPanel>

                            <Border Style="{StaticResource SourceTileBorder}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Device input" Style="{StaticResource TinyLabel}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding DeviceInputSources}"
                                                  SelectedItem="{Binding SelectedDeviceInputSource}"
                                                  DisplayMemberPath="DisplayName"
                                                  MinWidth="200"/>
                                        <TextBlock Text="{Binding DeviceInputDisplay}"
                                                   Style="{StaticResource DimText}"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Apply"
                                            Command="{Binding SetInputSourceCommand}"
                                            Style="{StaticResource AccentButton}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- 5. Device Controls: volume, limit, balance, gain/DRE, slot name -->
                    <Expander Header="Device Controls"
                              IsExpanded="False"
                              Foreground="{StaticResource WolfMutedBrush}"
                              Margin="0,0,0,10"
                              IsEnabled="{Binding SelectedDeviceSupportsBleDeviceControls}">
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hardware controls" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Changes are sent to the connected device"
                                               Style="{StaticResource DimText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Refresh values"
                                        Command="{Binding ReadDeviceControlsCommand}"
                                        Style="{StaticResource QuietButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,8" Padding="14,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Volume" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Listening level" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DeviceVolume, StringFormat={}{0:0}}"
                                                   Foreground="{DynamicResource WolfGreenBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Command="{Binding VolumeDownCommand}"
                                                Style="{StaticResource QuietButton}"
                                                Width="34" Height="34" MinHeight="0" Padding="0" Margin="0"
                                                ToolTip="Volume down">
                                            <controls:PhosphorIcon IconName="Minus" IconSize="13" IconBrush="{StaticResource WolfMutedBrush}"/>
                                        </Button>
                                        <controls:StyledSlider Grid.Column="1"
                                                               Margin="4,0"
                                                               Minimum="0"
                                                               Maximum="99"
                                                               Value="{Binding DeviceVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               Step="1"
                                                               AccentColor="{DynamicResource WolfGreen}"
                                                               ShowLabel="False"/>
                                        <Button Grid.Column="2"
                                                Command="{Binding VolumeUpCommand}"
                                                Style="{StaticResource QuietButton}"
                                                Width="34" Height="34" MinHeight="0" Padding="0" Margin="0"
                                                ToolTip="Volume up">
                                            <controls:PhosphorIcon IconName="Plus" IconSize="13" IconBrush="{StaticResource WolfMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,8" Padding="14,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Volume limit" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Maximum allowed output" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DeviceVolumeLimit, StringFormat={}{0:0}/99}"
                                                   Foreground="{DynamicResource WolfGreenBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <controls:StyledSlider Minimum="0"
                                                           Maximum="99"
                                                           Value="{Binding DeviceVolumeLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Step="1"
                                                           AccentColor="{DynamicResource WolfGreen}"
                                                           ShowLabel="False"/>
                                    <DockPanel Margin="10,-1,10,0">
                                        <TextBlock Text="0" Style="{StaticResource TinyLabel}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="99" Style="{StaticResource TinyLabel}" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,8" Padding="14,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,5" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Channel balance" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Shift the stereo image left or right" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Background="{StaticResource WolfAccentHoverBrush}"
                                                BorderBrush="#5500E676"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceChannelBalanceDisplay}"
                                                       Foreground="{DynamicResource WolfGreenBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </DockPanel>
                                    <controls:StyledSlider Minimum="-10"
                                                           Maximum="10"
                                                           Value="{Binding DeviceChannelBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Step="1"
                                                           CenterOrigin="True"
                                                           AccentColor="{DynamicResource WolfGreen}"
                                                           ShowLabel="False"/>
                                    <Grid Margin="10,-1,10,0">
                                        <TextBlock Text="L 10" Style="{StaticResource TinyLabel}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="CENTER" Style="{StaticResource TinyLabel}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="R 10" Style="{StaticResource TinyLabel}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,8" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="Playback mode" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Device-level gain and dynamic-range options"
                                               Style="{StaticResource DimText}"
                                               Margin="0,3,0,10"/>
                                    <WrapPanel>
                                        <CheckBox Content="High gain"
                                                  IsChecked="{Binding DeviceHighGain, Mode=TwoWay}"
                                                  Margin="0,0,22,0"/>
                                        <CheckBox Content="Dynamic range enhancement"
                                                  IsChecked="{Binding DeviceDreEnabled, Mode=TwoWay}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,10" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="EQ slot name" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Up to 8 characters" Style="{StaticResource DimText}" Margin="0,2,0,7"/>
                                        <TextBox Text="{Binding DeviceProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="8"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Rename"
                                            Command="{Binding RenameUserSlotCommand}"
                                            Style="{StaticResource QuietButton}"
                                            VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding DeviceControlsStatus}"
                                       Style="{StaticResource DimText}"
                                       TextWrapping="Wrap"
                                       Margin="2,0"/>
                        </StackPanel>
                    </Expander>

                    <!-- 6. Profile Lights: top / knob LED color, mode, power, scenes -->
                    <Expander Header="Profile Lights"
                              IsExpanded="False"
                              Foreground="{StaticResource WolfMutedBrush}"
                              Margin="0,0,0,10"
                              Visibility="{Binding SelectedDeviceSupportsBleLighting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                <Button Content="Refresh"
                                        Command="{Binding ReadLightsCommand}"
                                        Style="{StaticResource QuietButton}"
                                        DockPanel.Dock="Right"/>
                            </DockPanel>

                            <StackPanel>
                                <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Top Light" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding TopLedSummary}"
                                                           Style="{StaticResource DimText}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Click="TopLedPower_Click"
                                                    Style="{StaticResource QuietButton}"
                                                    DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Text" Value="Off"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TopLedOn}" Value="False">
                                                                    <Setter Property="Text" Value="On"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </DockPanel>

                                        <TextBlock Text="Color" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding LedColorOptions}" Margin="0,0,0,12">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="TopLedColorSwatch_Click"
                                                            Width="34"
                                                            Height="34"
                                                            Margin="0,0,7,7"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding Name}"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="{x:Type Button}">
                                                                <Grid Width="34" Height="34">
                                                                    <Border x:Name="SelectionRing"
                                                                            Width="34"
                                                                            Height="34"
                                                                            CornerRadius="17"
                                                                            BorderBrush="Transparent"
                                                                            BorderThickness="0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                    <Border x:Name="Dot"
                                                                            Width="24"
                                                                            Height="24"
                                                                            CornerRadius="12"
                                                                            Background="{Binding Brush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Dot" Property="Opacity" Value="0.82"/>
                                                                    </Trigger>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                                                <Binding/>
                                                                                <Binding Path="DataContext.SelectedTopLedColorOption"
                                                                                         RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource WolfTextBrush}"/>
                                                                        <Setter TargetName="SelectionRing" Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Mode" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding LedModeOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}"
                                                            Click="TopLedMode_Click"
                                                            Style="{StaticResource QuietButton}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SourceTileBorder}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Knob Light" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding KnobLedSummary}"
                                                           Style="{StaticResource DimText}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Click="KnobLedPower_Click"
                                                    Style="{StaticResource QuietButton}"
                                                    DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Text" Value="Off"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding KnobLedOn}" Value="False">
                                                                    <Setter Property="Text" Value="On"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </DockPanel>

                                        <TextBlock Text="Color" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding LedColorOptions}" Margin="0,0,0,12">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="KnobLedColorSwatch_Click"
                                                            Width="34"
                                                            Height="34"
                                                            Margin="0,0,7,7"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding Name}"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="{x:Type Button}">
                                                                <Grid Width="34" Height="34">
                                                                    <Border x:Name="SelectionRing"
                                                                            Width="34"
                                                                            Height="34"
                                                                            CornerRadius="17"
                                                                            BorderBrush="Transparent"
                                                                            BorderThickness="0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                    <Border x:Name="Dot"
                                                                            Width="24"
                                                                            Height="24"
                                                                            CornerRadius="12"
                                                                            Background="{Binding Brush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Dot" Property="Opacity" Value="0.82"/>
                                                                    </Trigger>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                                                <Binding/>
                                                                                <Binding Path="DataContext.SelectedKnobLedColorOption"
                                                                                         RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{StaticResource WolfTextBrush}"/>
                                                                        <Setter TargetName="SelectionRing" Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Mode" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding LedModeOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}"
                                                            Click="KnobLedMode_Click"
                                                            Style="{StaticResource QuietButton}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Presets"
                                       Style="{StaticResource TinyLabel}"
                                       Margin="0,14,0,8"/>
                            <ItemsControl ItemsSource="{Binding LedSceneOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}"
                                                Click="LedScene_Click"
                                                Style="{StaticResource QuietButton}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- 7. About: version, updates, releases, support -->
                    <Expander Header="About"
                              IsExpanded="False"
                              Foreground="{StaticResource WolfMutedBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                <Button Content="Releases"
                                        Command="{Binding OpenReleasesCommand}"
                                        Style="{StaticResource QuietButton}"
                                        DockPanel.Dock="Right"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="WolfEQ"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AppVersionText}"
                                               Style="{StaticResource DimText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Check for Updates"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        Style="{StaticResource AccentButton}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{Binding UpdateStatus}"
                                       Style="{StaticResource DimText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Button Command="{Binding OpenBuyMeCoffeeCommand}"
                                    Style="{StaticResource QuietButton}"
                                    HorizontalAlignment="Left"
                                    ToolTip="buymeacoffee.com/audioslayer">
                                <StackPanel Orientation="Horizontal">
                                    <controls:PhosphorIcon IconName="Heart"
                                                           IconSize="15"
                                                           IconBrush="{DynamicResource WolfGreenBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="Buy me a coffee"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
