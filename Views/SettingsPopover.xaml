                                                <DataTemplate>
                                                    <Button Click="TopLedColorSwatch_Click"
                                                            Width="34"
                                                            Height="34"
                                                            Margin="0,0,7,7"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding Name}"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="{x:Type Button}">
