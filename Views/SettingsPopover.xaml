<UserControl x:Class="WolfEQ.Views.SettingsPopover"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WolfEQ"
             xmlns:controls="clr-namespace:WolfEQ.Controls"
             xmlns:views="clr-namespace:WolfEQ.Views"
             mc:Ignorable="d"
             d:DesignWidth="460"
             d:DesignHeight="820"
             Width="460"
             Foreground="{DynamicResource WolfTextBrush}">
    <UserControl.Resources>
        <Geometry x:Key="DiscordLogoGeometry">M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z</Geometry>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Copied from MainWindow resources; views keep their own converter copies. -->
        <local:ReferenceEqualsMultiConverter x:Key="ReferenceEqualsMultiConverter"/>
        <controls:StringEqualsConverter x:Key="StringEquals"/>
        <views:RepeatsTextMultiConverter x:Key="RepeatsText"/>

        <!-- Fixed section colours (independent of the accent theme). -->
        <SolidColorBrush x:Key="SectionDeviceBrush" Color="#00E676"/>
        <SolidColorBrush x:Key="SectionSoundBrush" Color="#38BDF8"/>
        <LinearGradientBrush x:Key="SectionLightsBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFC94A" Offset="0"/>
            <GradientStop Color="#FF7A90" Offset="0.5"/>
            <GradientStop Color="#B25CFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SectionWindowsBrush" Color="#A78BFA"/>
        <SolidColorBrush x:Key="SectionShortcutsBrush" Color="#FF7A90"/>
        <SolidColorBrush x:Key="SectionLookBrush" Color="#F472B6"/>
        <SolidColorBrush x:Key="SectionAboutBrush" Color="#94A3B8"/>

        <!-- Status chip in the device hero: green dot when OK, amber when it needs attention. -->
        <Style x:Key="HeroChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0,11,0"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <!-- Chip buttons: drop the app-wide button minimum height so every chip is the same 26 px pill. -->
        <Style x:Key="HeroChipButton" TargetType="Button">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Lights editor: Both / Top / Knob underline tabs (same look as Faders / Table in BandControls). -->
        <Style x:Key="LightZoneChoice" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Rail" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lights editor: rounded chip with a green outline when it is the current choice. -->
        <Style x:Key="LightChoiceBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <DataTemplate x:Key="SettingsSectionHeader">
            <DockPanel LastChildFill="True">
                <!-- Icon tile tinted with the section's own colour (SectionColor). -->
                <Grid DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,11,0" VerticalAlignment="Center">
                    <Border CornerRadius="{StaticResource RadiusControl}" Opacity="0.16" Background="{Binding (views:SettingsPopover.SectionColor), RelativeSource={RelativeSource AncestorType=Expander}}"/>
                    <Border CornerRadius="{StaticResource RadiusControl}" Opacity="0.4" BorderThickness="1" BorderBrush="{Binding (views:SettingsPopover.SectionColor), RelativeSource={RelativeSource AncestorType=Expander}}"/>
                    <controls:PhosphorIcon IconName="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" IconSize="17"
                                           IconBrush="{Binding (views:SettingsPopover.SectionColor), RelativeSource={RelativeSource AncestorType=Expander}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SectionSummaryText"
                               Text="{Binding (views:SettingsPopover.SectionSummary), RelativeSource={RelativeSource AncestorType=Expander}}"
                               Style="{StaticResource TinyLabel}"
                               FontWeight="Normal"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                    <Setter TargetName="SectionSummaryText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=SectionSummaryText}" Value="">
                    <Setter TargetName="SectionSummaryText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <controls:PhosphorIcon IconName="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" IconSize="13" IconBrush="{DynamicResource WolfGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                        <controls:PhosphorIcon.Style><Style TargetType="controls:PhosphorIcon"><Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></controls:PhosphorIcon.Style>
                    </controls:PhosphorIcon>
                    <ContentPresenter Content="{Binding}" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate></Setter.Value></Setter></Style>
        <!-- Button tiers inside Settings (same as the app-wide ones, plus an optional Tag icon):
             Primary = solid green, at most one visible per section; Secondary = green outline, soft fill;
             SettingsActionButton = plain button with a green icon; QuietButton = ghost. -->
        <Style x:Key="SettingsSecondaryButton" TargetType="Button" BasedOn="{StaticResource SettingsActionButton}">
            <Setter Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsActionButton}">
            <Setter Property="Background" Value="{DynamicResource WolfGreenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfGreenContrastBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- Icon takes the button's text colour so it stays visible on solid green. -->
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <controls:PhosphorIcon IconName="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" IconSize="13" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center">
                        <controls:PhosphorIcon.Style><Style TargetType="controls:PhosphorIcon"><Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></controls:PhosphorIcon.Style>
                    </controls:PhosphorIcon>
                    <ContentPresenter Content="{Binding}" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsTabs" TargetType="TabControl" BasedOn="{StaticResource StudioTabs}"/>
        <Style x:Key="SettingsTab" TargetType="TabItem" BasedOn="{StaticResource StudioTab}"/>
    </UserControl.Resources>

    <Border Style="{StaticResource OverlayPanelBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Same header as the Preset library overlay: 36 px icon tile, title + caption, 32 px close. -->
            <Grid Grid.Row="0" Margin="18,16,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36"
                        Height="36"
                        Background="{DynamicResource WolfAccentHoverBrush}"
                        BorderBrush="{DynamicResource WolfLineSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}">
                    <controls:PhosphorIcon IconName="Gear"
                                           IconSize="18"
                                           IconBrush="{DynamicResource WolfGreenBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Settings" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="Your device, sound, lights and shortcuts" Style="{StaticResource DimText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Style="{StaticResource OverlayCloseButton}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        ToolTip="Close settings"
                        Click="CloseButton_Click">
                    <Path Width="11"
                          Height="11"
                          Data="M 1,1 L 10,10 M 10,1 L 1,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Margin="12,0"
                    Background="{DynamicResource WolfLineBrush}"/>

            <ScrollViewer Grid.Row="2"
                          Margin="10,10,6,10"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="2,0,4,0">

                    <!-- Device hero: your device, its live lights, and connection status at a glance. -->
                    <Border x:Name="DeviceHero" CornerRadius="{StaticResource RadiusCard}" Padding="14,12,14,14" Margin="0,0,0,8" BorderThickness="1"
                            BorderBrush="{DynamicResource WolfLineSoftBrush}" Background="{DynamicResource WolfShellBrush}"
                            Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Lit drawing for devices with lights; the product photo otherwise. -->
                            <Grid Width="270" Height="92" HorizontalAlignment="Center"
                                  Visibility="{Binding SelectedDeviceSupportsBleLighting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid VerticalAlignment="Top" Height="22">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TopLightPreviewBreathing}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="HeroTopBreathing">
                                                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="HeroTopBreathing"/></DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border Width="200" Height="9" CornerRadius="4" Background="{Binding TopLightPreviewBrush}" Opacity="0.75" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                        <Border.Effect><BlurEffect Radius="14"/></Border.Effect>
                                    </Border>
                                    <Border Width="200" Height="5" CornerRadius="3" Background="{Binding TopLightPreviewBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </Grid>
                                <Border Margin="0,22,0,0" CornerRadius="10" Background="#15181D" BorderBrush="#2E343C" BorderThickness="1">
                                    <Grid>
                                        <Border Width="84" Height="26" CornerRadius="4" Background="#0B0D10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0">
                                            <TextBlock Text="{Binding SelectedDeviceUserPreset.DeviceName}" FontSize="11" Foreground="#7C8794" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Grid Width="50" Height="50" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KnobLightPreviewBreathing}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="HeroKnobBreathing">
                                                                    <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="HeroKnobBreathing"/></DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Ellipse Stroke="{Binding KnobLightPreviewBrush}" StrokeThickness="7" Opacity="0.6">
                                                <Ellipse.Effect><BlurEffect Radius="10"/></Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse Stroke="{Binding KnobLightPreviewBrush}" StrokeThickness="3" Fill="#0E1013" Margin="3"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Image Source="{Binding SelectedDeviceProfile.ProductImagePath}" Height="76" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDeviceSupportsBleLighting}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <DockPanel Margin="0,12,0,0">
                                <Button Command="{Binding ConnectCommand}" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" ToolTip="Reconnect device" AutomationProperties.Name="Reconnect device" Width="30" Height="28" MinHeight="0" Padding="0" Margin="0" VerticalAlignment="Center">
                                    <Path Data="M16,6 A7,7 0 1 0 17,12 M16,1 V6 H11" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource WolfMutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DeviceNickname}" Style="{StaticResource PanelTitle}"/>
                                        <controls:HelpTip Title="Two connections" Text="USB carries your audio, EQ and USER slots. Bluetooth only drives the lights and the input switch."
                                                          Visibility="{Binding SelectedDeviceSupportsBleLighting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <!-- Model name only when the user has renamed the device; otherwise just the slot in use. -->
                                    <TextBlock Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                                                <Setter Property="Text">
                                                    <Setter.Value>
                                                        <MultiBinding StringFormat="{}{0}  ·  Using {1}">
                                                            <Binding Path="SelectedDeviceProfile.DisplayName"/>
                                                            <Binding Path="SelectedDeviceUserPreset.DeviceName"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource RepeatsText}">
                                                                <Binding Path="DeviceNickname"/>
                                                                <Binding Path="SelectedDeviceProfile.DisplayName"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Text" Value="{Binding SelectedDeviceUserPreset.DeviceName, StringFormat='Using {0}'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <!-- Status chips: green = working; amber = click to fix. -->
                            <!-- Negative bottom margin cancels the chips' 6 px wrap gap so the card padding stays even. -->
                            <WrapPanel Margin="0,10,0,-6">
                                <Button Command="{Binding ConnectCommand}" Style="{StaticResource HeroChipButton}" AutomationProperties.Name="USB status">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Style="{StaticResource HeroChip}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource WolfWarningBrush}"/>
                                                    <TextBlock x:Name="Label" Text="USB not found · Reconnect" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource WolfTextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WolfGreenBrush}"/>
                                                    <Setter TargetName="Label" Property="Text" Value="USB connected"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Click="SetUpBluetooth_Click" Style="{StaticResource HeroChipButton}" AutomationProperties.Name="Bluetooth status"
                                        Visibility="{Binding SelectedDeviceSupportsBleLighting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Style="{StaticResource HeroChip}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource WolfWarningBrush}"/>
                                                    <TextBlock x:Name="Label" Text="Set up Bluetooth" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource WolfTextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBluetoothSaved}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WolfGreenBrush}"/>
                                                    <Setter TargetName="Label" Property="Text" Value="Bluetooth ready"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Expander x:Name="DeviceSection" Header="Your device" Tag="Cpu"
                              views:SettingsPopover.SectionColor="{StaticResource SectionDeviceBrush}"
                              views:SettingsPopover.SectionSummary="{Binding DeviceSectionSummary}" HeaderTemplate="{StaticResource SettingsSectionHeader}" IsExpanded="False" Margin="0,0,0,8">
 <StackPanel Margin="0,10,0,0">
 <!-- Model picker stays visible in both modes so users can switch between FiiO and Software EQ. -->
 <StackPanel Margin="0,0,0,12">
 <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
     <TextBlock Text="Model" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
     <controls:HelpTip Title="{Binding SelectedDeviceProfile.DisplayName}" Text="{Binding DeviceModelHelpText}"/>
 </StackPanel>
 <ComboBox ItemsSource="{Binding DeviceProfiles}" SelectedItem="{Binding SelectedDeviceProfile}" TextSearch.TextPath="DisplayLabel" AutomationProperties.Name="Device">
     <ComboBox.ItemTemplate>
         <DataTemplate>
             <StackPanel Orientation="Horizontal">
                 <Image Source="{Binding ProductImagePath}" Width="40" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                 <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"/>
             </StackPanel>
         </DataTemplate>
     </ComboBox.ItemTemplate>
 </ComboBox>
 </StackPanel>
 <StackPanel Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
 <StackPanel IsEnabled="{Binding IntegrationControlsEnabled}">
                            <!-- Same stacked label-over-field pattern as Model and USER slot name. -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Device name" Style="{StaticResource TinyLabel}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding DeviceNickname, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Device name" ToolTip="A friendly name for this saved connection"/>
                            </StackPanel>
                            <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <Button Style="{StaticResource SettingsActionButton}" Tag="MagnifyingGlass" Content="Refresh" DockPanel.Dock="Right" Command="{Binding RefreshUsbDevicesCommand}" Padding="10,4" MinHeight="28" Margin="8,0,0,0" ToolTip="Look for connected USB devices"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="USB" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Equalizer &amp; USER slots" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <ComboBox ItemsSource="{Binding UsbDevices}" SelectedItem="{Binding SelectedUsbDevice}" ToolTip="{Binding SelectedUsbDevice.Path}" MinHeight="34">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="305" ToolTip="{Binding Path}"/></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="Select a USB device" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource WolfDimBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedUsbDevice}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                <Button Style="{StaticResource SettingsPrimaryButton}" Tag="Link" Content="Save USB device" DockPanel.Dock="Right" Command="{Binding SaveDeviceBindingCommand}" Padding="12,6" Margin="10,0,0,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Only this unit is used." Style="{StaticResource DimText}" VerticalAlignment="Center"/><controls:HelpTip Title="Save USB device" Text="Saves the USB device and name above. WolfEQ never talks to another unit. If you move the K13 to a different USB port, pick it again here."/></StackPanel>
                            </DockPanel>

                            <!-- Bluetooth: guided find → flash → confirm. Saving happens on "Yes, use it". -->
                            <Border x:Name="BluetoothCard" Style="{StaticResource SourceTileBorder}" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,3" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBluetoothSaved}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource WolfDimBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBluetoothSaved}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource WolfGreenBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding BluetoothStatusText}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Bluetooth" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="For lights and input switching." Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Not set up -->
                                    <StackPanel Visibility="{Binding ShowBluetoothFindPrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Switch your K13 on, then let WolfEQ find it. It takes about 8 seconds and you won't need to pair it in Windows." Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Button Style="{StaticResource SettingsSecondaryButton}" Tag="MagnifyingGlass" Content="Find my K13" Command="{Binding FindBluetoothCommand}" HorizontalAlignment="Left" Padding="14,6"/>
                                    </StackPanel>

                                    <!-- Searching -->
                                    <DockPanel Visibility="{Binding IsBluetoothSearching, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,2">
                                        <ProgressBar IsIndeterminate="True" Width="70" Height="4" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                                                     Foreground="{DynamicResource WolfGreenBrush}" Background="#1AFFFFFF" BorderThickness="0"/>
                                        <TextBlock Text="Looking for nearby K13s..." Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Found one: confirm it's this desk's unit -->
                                    <StackPanel Visibility="{Binding IsBluetoothConfirming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Found" Style="{StaticResource TinyLabel}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding BluetoothCandidateDisplay}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Did your K13 flash green?" Style="{StaticResource CardTitle}" Margin="0,12,0,8"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource SettingsSecondaryButton}" Content="Yes, use it" Command="{Binding ConfirmBluetoothCommand}" Padding="14,6" Margin="0,0,8,6"/>
                                            <Button Style="{StaticResource SettingsActionButton}" Content="No, try another" Command="{Binding RejectBluetoothCommand}" Padding="12,6" Margin="0,0,8,6"/>
                                            <Button Style="{StaticResource SettingsActionButton}" Tag="Lightbulb" Content="Flash again" Command="{Binding FlashBluetoothCommand}" Padding="12,6" Margin="0,0,8,6"/>
                                            <Button Style="{StaticResource QuietButton}" Content="Cancel" Command="{Binding CancelBluetoothSetupCommand}" Margin="0,0,0,6"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Set up -->
                                    <StackPanel Visibility="{Binding ShowBluetoothSavedDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SavedBluetoothDisplay}" FontWeight="SemiBold"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource SettingsActionButton}" Tag="Lightbulb" Content="Flash lights" Command="{Binding FlashBluetoothCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="Flash the K13's lights green for a moment to check WolfEQ can reach it"/>
                                            <Button Style="{StaticResource SettingsActionButton}" Tag="MagnifyingGlass" Content="Change" Command="{Binding FindBluetoothCommand}" Padding="12,5" Margin="0,0,8,0" ToolTip="Search again and pick a different K13"/>
                                            <Button Style="{StaticResource QuietButton}" Content="Forget" Command="{Binding ForgetBluetoothCommand}" ToolTip="Stop using this K13 over Bluetooth"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding BluetoothSetupMessage}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Visibility="{Binding HasBluetoothSetupMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
 </StackPanel>
 <Border Height="1" Background="{DynamicResource WolfLineSoftBrush}" Margin="0,14,0,12"/>
 <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
     <TextBlock Text="USER slot name" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
     <controls:HelpTip Title="USER slot name" Text="Renames the USER slot that's playing now, up to 8 characters. WolfEQ shows this name; the K13's own screen keeps its built-in label."/>
 </StackPanel>
 <DockPanel>
 <Button Style="{StaticResource SettingsActionButton}" Tag="Keyboard" Content="Rename" Command="{Binding RenameUserSlotCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
 <TextBox Text="{Binding DeviceProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" ToolTip="Up to 8 characters"/>
 </DockPanel>
 </StackPanel>

                            <!-- Software EQ card: replaces the hardware Connections/Controls tabs in Software EQ mode. -->
                            <Border x:Name="SystemEqCard"
                                    Padding="13,12"
                                    Background="{DynamicResource WolfShellBrush}"
                                    BorderBrush="{DynamicResource WolfLineSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}"
                                    Visibility="{Binding IsSystemEqSelected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Software EQ" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{Binding SystemEqStatusText}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" ToolTip="Turn off WolfEQ's effect without losing your EQ">
                                            <TextBlock Text="Bypass" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WolfMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton Style="{StaticResource BandPowerToggle}" IsChecked="{Binding SystemEqBypassed, Mode=TwoWay}" AutomationProperties.Name="Bypass Software EQ" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Setup steps, driven by SystemEqState. -->
                                    <TextBlock Text="Checking Equalizer APO..." Margin="0,10,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DimText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SystemEqState}" Value="Checking"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <Border Margin="0,12,0,0">
                                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SourceTileBorder}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SystemEqState}" Value="NeedsInstall"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Install Equalizer APO" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="WolfEQ uses the free Equalizer APO engine to apply your EQ to Windows outputs. It isn't installed yet." Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            <Button x:Name="InstallApoButton" Content="Install Equalizer APO" Command="{Binding InstallEqualizerApoCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0" Tag="Cloud">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsPrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSystemEqSetupBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <!-- Shown while the installer is checked, downloaded, and running. -->
                                            <StackPanel x:Name="ApoSetupProgressPanel">
                                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSystemEqSetupBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <TextBlock Text="{Binding SystemEqSetupProgressText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                                                <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                             Value="{Binding SystemEqSetupProgressPercent, Mode=OneWay}"
                                                             IsIndeterminate="{Binding IsSystemEqSetupProgressIndeterminate}"
                                                             Foreground="{DynamicResource WolfGreenBrush}"
                                                             AutomationProperties.Name="Equalizer APO setup progress"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,12,0,0">
                                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SourceTileBorder}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SystemEqState}" Value="NeedsDeviceSelection"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Add your outputs" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Equalizer APO is installed but not on any output yet. Pick your outputs in its device selector." Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            <Button Style="{StaticResource SettingsPrimaryButton}" Tag="SpeakerHigh" Content="Add outputs in Equalizer APO" Command="{Binding OpenApoDeviceSelectorCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0"/>
                                            <TextBlock Text="Windows may need a restart before the EQ is heard." Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,12,0,0">
                                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SourceTileBorder}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SystemEqState}" Value="Blocked"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Software EQ is paused" Style="{StaticResource CardTitle}" Foreground="{DynamicResource WolfWarningBrush}"/>
                                            <TextBlock Text="{Binding SystemEqWarningText}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Double-EQ / enhancements warning. The Blocked step above already shows the reason. -->
                                    <Border Padding="10,8" Margin="0,12,0,0" BorderBrush="{DynamicResource WolfWarningBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource WolfPanel2Brush}">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="{Binding HasSystemEqWarning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/><Style.Triggers><DataTrigger Binding="{Binding SystemEqState}" Value="Blocked"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding SystemEqWarningText}" Foreground="{DynamicResource WolfWarningBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Endpoint picker -->
                                    <DockPanel LastChildFill="True" Margin="0,14,0,8">
                                        <Button Style="{StaticResource SettingsActionButton}" Tag="Plus" Content="Add outputs" DockPanel.Dock="Right" Command="{Binding OpenApoDeviceSelectorCommand}" Padding="10,4" MinHeight="28" Margin="6,0,0,0" ToolTip="Install Equalizer APO on more outputs"/>
                                        <Button Style="{StaticResource SettingsActionButton}" Tag="MagnifyingGlass" Content="Refresh" DockPanel.Dock="Right" Command="{Binding RefreshSystemEqEndpointsCommand}" Padding="10,4" MinHeight="28" Margin="6,0,0,0" ToolTip="Look for outputs again"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Outputs" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="EQ applies only to ticked outputs." Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl x:Name="SystemEqEndpointList" ItemsSource="{Binding SystemEqEndpoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,1,8,0" AutomationProperties.Name="{Binding Name}" ToolTip="Apply EQ to this output"/>
                                                        <StackPanel Grid.Column="1">
                                                            <DockPanel LastChildFill="True">
                                                                <Border DockPanel.Dock="Right" Background="{DynamicResource WolfAccentHoverBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsFiio, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="FiiO device: its own EQ may stack with Software EQ">
                                                                    <TextBlock Text="FiiO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WolfGreenBrush}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/><Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsApoActive}" Value="False"><Setter Property="Foreground" Value="{DynamicResource WolfWarningBrush}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding EnhancementsDisabled}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WolfWarningBrush}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers></Style></TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No outputs found. Refresh, or add outputs in Equalizer APO." TextWrapping="Wrap" Margin="2,0,0,4">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DimText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=SystemEqEndpointList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>

                                    <Border Height="1" Background="{DynamicResource WolfLineSoftBrush}" Margin="0,8,0,6"/>
                                    <Button Content="Remove from Equalizer APO" Command="{Binding RemoveSystemEqFromApoCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="2,4" Margin="0" MinHeight="0" Cursor="Hand"
                                            ToolTip="Remove WolfEQ's EQ from Equalizer APO. Other APO settings stay as they are."/>
                                </StackPanel>
                            </Border>
 </StackPanel>
 </Expander>

                    <Expander x:Name="SoundSection" Header="Sound" Tag="SlidersHorizontal"
                              views:SettingsPopover.SectionColor="{StaticResource SectionSoundBrush}"
                              views:SettingsPopover.SectionSummary="{Binding SoundSectionSummary}" HeaderTemplate="{StaticResource SettingsSectionHeader}"
                              IsExpanded="False"
                              Foreground="{DynamicResource WolfMutedBrush}"
                              Margin="0,0,0,8"
                              Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0,10,0,0">
                            <DockPanel Margin="0,0,0,12">
                                <Button Style="{StaticResource QuietButton}" Content="Read from device" Command="{Binding ReadDeviceControlsCommand}" DockPanel.Dock="Right"
                                        ToolTip="Show the values on your device right now"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="On your device" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    <controls:HelpTip Title="Sound" Text="These settings live on the device itself. Switching input uses Bluetooth; everything else uses USB."/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,14" IsEnabled="{Binding SelectedDeviceSupportsBleInput}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Input" Foreground="{DynamicResource WolfTextBrush}"/>
                                    <controls:HelpTip Title="Input" Text="Which source the device plays from. Pick one and press Apply. Needs Bluetooth to be set up."/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceInputSources}" SelectedItem="{Binding SelectedDeviceInputSource}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Input"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Command="{Binding ReadInputSourceCommand}" Style="{StaticResource QuietButton}" Margin="6,0,0,0" Padding="6" ToolTip="Check which input is on now" AutomationProperties.Name="Check current input">
                                        <controls:PhosphorIcon IconName="MagnifyingGlass" IconSize="14" IconBrush="{DynamicResource WolfMutedBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource SettingsPrimaryButton}" Tag="ArrowRight" Content="Apply" Command="{Binding SetInputSourceCommand}" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel IsEnabled="{Binding SelectedDeviceSupportsBleDeviceControls}">
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DeviceVolume}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource WolfTextBrush}"/>
                                    <TextBlock Text="Volume" Foreground="{DynamicResource WolfMutedBrush}"/>
                                </DockPanel>
                                <controls:StyledSlider Minimum="0" Maximum="99" Value="{Binding DeviceVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Step="1" AccentColor="{DynamicResource WolfGreen}" ShowLabel="False" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DeviceVolumeLimit}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource WolfTextBrush}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Volume limit" Foreground="{DynamicResource WolfMutedBrush}"/>
                                        <controls:HelpTip Title="Volume limit" Text="The highest the volume can go. Protects sensitive headphones from a sudden loud turn of the knob."/>
                                    </StackPanel>
                                </DockPanel>
                                <controls:StyledSlider Minimum="0" Maximum="99" Value="{Binding DeviceVolumeLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Step="1" AccentColor="{DynamicResource WolfGreen}" ShowLabel="False" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DeviceChannelBalanceDisplay}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource WolfTextBrush}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Balance" Foreground="{DynamicResource WolfMutedBrush}"/>
                                        <controls:HelpTip Title="Balance" Text="Shifts the sound toward the left or right ear. Leave it centred unless one side sounds louder."/>
                                    </StackPanel>
                                </DockPanel>
                                <controls:StyledSlider Minimum="-10" Maximum="10" Value="{Binding DeviceChannelBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Step="1" AccentColor="{DynamicResource WolfGreen}" ShowLabel="False" CenterOrigin="True" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                    <CheckBox Content="High gain" IsChecked="{Binding DeviceHighGain, Mode=TwoWay}"/>
                                    <controls:HelpTip Title="High gain" Text="More power for hard-to-drive headphones. Leave it off for IEMs and most closed-backs."/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Last read/write result: a quiet status line. Long technical errors are capped at three lines; hover shows all of it. -->
                            <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource WolfShellBrush}"
                                    ToolTip="{Binding DeviceControlsStatus}" ToolTipService.ShowDuration="60000">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DeviceControlsStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding DeviceControlsStatus}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource WolfDimBrush}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                                    <TextBlock Text="{Binding DeviceControlsStatus}" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                               LineHeight="15" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="LightsSection" Header="Lights" Tag="Lightbulb" views:SettingsPopover.SectionColor="{StaticResource SectionLightsBrush}" views:SettingsPopover.SectionSummary="{Binding LightsSectionSummary}" HeaderTemplate="{StaticResource SettingsSectionHeader}"
                              IsExpanded="False"
                              Foreground="{DynamicResource WolfMutedBrush}"
                              Margin="0,0,0,8"
                              Visibility="{Binding SelectedDeviceSupportsBleLighting, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0,10,0,0">

                            <!-- Lights only work over Bluetooth: say so, and link straight to setup. -->
                            <Border Style="{StaticResource SourceTileBorder}" Margin="0,0,0,12"
                                    BorderBrush="{DynamicResource WolfGreenBrush}" BorderThickness="1"
                                    Visibility="{Binding LightsNeedBluetooth, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Set up Bluetooth to change the lights" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="The K13's lights work over Bluetooth. Setup is quick and needs no Windows pairing." Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                    <Button Style="{StaticResource SettingsPrimaryButton}" Tag="MagnifyingGlass" Content="Set up Bluetooth" Click="SetUpBluetooth_Click" HorizontalAlignment="Left" Padding="14,6"/>
                                </StackPanel>
                            </Border>

                            <StackPanel IsEnabled="{Binding IsBluetoothSaved}">
                                <DockPanel Margin="0,0,0,2">
                                    <Button Style="{StaticResource QuietButton}" Content="Read from K13" Command="{Binding ReadLightsCommand}" DockPanel.Dock="Right"
                                            ToolTip="Show the colors that are on your K13 right now"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding LightsEditingTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/><controls:HelpTip Title="Lights" Text="Each USER slot remembers its own lights and shows them when you switch. Changes go to the K13 over Bluetooth."/></StackPanel>
                                </DockPanel>
                                
                                <CheckBox Content="Switch lights when I change USER slot" IsChecked="{Binding AutoSlotLighting}" IsEnabled="{Binding IntegrationControlsEnabled}" Margin="0,0,0,12"/>

                                <!-- Live preview of the K13: top light bar and volume knob ring. Kept small because the
                                     hero card above already shows the device; this one previews edits as you make them. -->
                                <Border Style="{StaticResource SourceTileBorder}" Padding="12,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="150" Stretch="Uniform" VerticalAlignment="Center">
                                        <Grid Width="270" Height="96" HorizontalAlignment="Center">
                                            <Grid VerticalAlignment="Top" Height="22">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TopLightPreviewBreathing}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="TopBreathing">
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="TopBreathing"/>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Border Width="200" Height="9" CornerRadius="4" Background="{Binding TopLightPreviewBrush}" Opacity="0.75" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                                    <Border.Effect><BlurEffect Radius="14"/></Border.Effect>
                                                </Border>
                                                <Border Width="200" Height="5" CornerRadius="3" Background="{Binding TopLightPreviewBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                            </Grid>
                                            <Border Margin="0,22,0,0" CornerRadius="10" Background="#15181D" BorderBrush="#2E343C" BorderThickness="1">
                                                <Grid>
                                                    <!-- Blank screen: at this scale a label would be too small to read. -->
                                                    <Border Width="84" Height="26" CornerRadius="4" Background="#0B0D10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0"/>
                                                    <Grid Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding KnobLightPreviewBreathing}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard x:Name="KnobBreathing">
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <StopStoryboard BeginStoryboardName="KnobBreathing"/>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Ellipse Stroke="{Binding KnobLightPreviewBrush}" StrokeThickness="7" Opacity="0.6">
                                                            <Ellipse.Effect><BlurEffect Radius="10"/></Ellipse.Effect>
                                                        </Ellipse>
                                                        <Ellipse Stroke="{Binding KnobLightPreviewBrush}" StrokeThickness="3" Fill="#0E1013" Margin="3"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        </Viewbox>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="Top" Style="{StaticResource TinyLabel}"/>
                                            <TextBlock Text="{Binding TopLightPreviewText}" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock Text="Knob" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding KnobLightPreviewText}" Foreground="{DynamicResource WolfTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Which light to edit, and its power switch. -->
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EditorLightOnText}" Foreground="{DynamicResource WolfTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ToggleButton Style="{StaticResource BandPowerToggle}" IsChecked="{Binding EditorLightOn, Mode=TwoWay}"
                                                      AutomationProperties.Name="Light on or off" ToolTip="Turn the selected light on or off" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Edit" Style="{StaticResource TinyLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <RadioButton GroupName="LightZone" Style="{StaticResource LightZoneChoice}" Content="Both"
                                                     IsChecked="{Binding LightEditZone, Converter={StaticResource StringEquals}, ConverterParameter=Both}"/>
                                        <RadioButton GroupName="LightZone" Style="{StaticResource LightZoneChoice}" Content="Top"
                                                     IsChecked="{Binding LightEditZone, Converter={StaticResource StringEquals}, ConverterParameter=Top}"/>
                                        <RadioButton GroupName="LightZone" Style="{StaticResource LightZoneChoice}" Content="Knob"
                                                     IsChecked="{Binding LightEditZone, Converter={StaticResource StringEquals}, ConverterParameter=Knob}"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Top and knob are set differently. What you pick now applies to both."
                                           Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Visibility="{Binding LightZonesDiffer, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Effects: everything the K13 can do by itself. -->
                                <TextBlock Text="Effect" Style="{StaticResource TinyLabel}" Margin="0,8,0,8"/>
                                <ItemsControl ItemsSource="{Binding LightEffectOptions}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="LightEffect_Click" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Name}" Cursor="Hand" Margin="0,0,5,6">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Chip" Style="{StaticResource LightChoiceBorder}">
                                                            <TextBlock x:Name="Label" Text="{Binding Name}" Foreground="{DynamicResource WolfMutedBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                                            </Trigger>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.EditorLightEffect" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Chip" Property="Opacity" Value="0.45"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Colors (for Solid and Breathing; picking one leaves Rainbow / Follow audio). -->
                                <TextBlock Text="Color" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding LightColorChoices}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="LightColor_Click" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Cursor="Hand" Width="52" Margin="0,0,2,6">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Background="Transparent">
                                                            <Grid Width="34" Height="34">
                                                                <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                                                                <Ellipse x:Name="Dot" Width="24" Height="24" Fill="{Binding Brush}"/>
                                                            </Grid>
                                                            <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource WolfDimBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Dot" Property="Opacity" Value="0.82"/>
                                                            </Trigger>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.EditorLightColor" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource WolfTextBrush}"/>
                                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Dot" Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Two-tone looks set both lights at once. -->
                                <TextBlock Text="Two-tone looks" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding LedSceneOptions}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="LightLook_Click" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Name}" Cursor="Hand" Margin="0,0,5,6">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Chip" Style="{StaticResource LightChoiceBorder}" Padding="10,6,12,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="10" Height="10" Fill="{Binding TopBrush}" VerticalAlignment="Center"/>
                                                                <Ellipse Width="10" Height="10" Fill="{Binding KnobBrush}" VerticalAlignment="Center" Margin="3,0,8,0"/>
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource WolfMutedBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Chip" Property="Opacity" Value="0.45"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Windows output" Tag="Monitor" views:SettingsPopover.SectionColor="{StaticResource SectionWindowsBrush}" views:SettingsPopover.SectionSummary="{Binding WindowsAudioSectionSummary}" HeaderTemplate="{StaticResource SettingsSectionHeader}"
                              IsExpanded="False"
                              Foreground="{DynamicResource WolfMutedBrush}"
                              Expanded="WindowsAudioExpander_Expanded"
                              Margin="0,0,0,8">
                        <StackPanel Margin="0,10,0,0">
                            <!-- Same inner tile as the USB and Bluetooth cards in Your device. -->
                            <Border Style="{StaticResource SourceTileBorder}" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Default format" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                                <controls:HelpTip Title="Default format" Text="The bit depth and sample rate Windows sends to your default output. Formats the output can't play are greyed out."/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding WindowsAudioCurrentFormat}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource WolfTextBrush}"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding WindowsAudioFormatStatus}"
                                                       Style="{StaticResource DimText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,12,0"/>
                                        </StackPanel>
                                        <!-- Same refresh glyph as the hero's reconnect button (there is no ArrowClockwise icon geometry). -->
                                        <Button Grid.Column="1"
                                                Command="{Binding RefreshWindowsAudioFormatsCommand}"
                                                Style="{StaticResource QuietButton}"
                                                Width="30" Height="28" MinHeight="0" Padding="0"
                                                VerticalAlignment="Top"
                                                ToolTip="Rescan the Windows default output"
                                                AutomationProperties.Name="Rescan Windows output">
                                            <Path Data="M16,6 A7,7 0 1 0 17,12 M16,1 V6 H11" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource WolfMutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding WindowsAudioQuickFormats}"
                                                  Margin="-4,12,-4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ApplyWindowsAudioQuickFormatCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding IsSupported}"
                                                        Height="48"
                                                        Margin="4,0"
                                                        Padding="5"
                                                        ToolTip="Apply this format to the Windows default output">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="CURRENT"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource WolfGreenBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SourceTileBorder}" Padding="12" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Spatial sound" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Windows Sonic, Dolby Atmos, or DTS"
                                                   Style="{StaticResource DimText}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Manage"
                                            Tag="ArrowRight"
                                            Command="{Binding OpenWindowsOutputSettingsCommand}"
                                            Style="{StaticResource SettingsActionButton}"
                                            ToolTip="Open Windows output settings"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <!-- Integrations show in both modes: USER slot switching is hardware-only, while
                         Software EQ mode has its own bypass and preset commands. -->
                    <Expander Header="Shortcuts" Tag="Keyboard" views:SettingsPopover.SectionColor="{StaticResource SectionShortcutsBrush}" views:SettingsPopover.SectionSummary="{Binding IntegrationsSectionSummary}" HeaderTemplate="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8">
                        <StackPanel Margin="0,10,0,0">
                        <StackPanel x:Name="HardwareStreamDeckPanel" Visibility="{Binding IsHardwareDeviceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Stream Deck keys" Style="{StaticResource CardTitle}"/>
                                <controls:HelpTip Title="Stream Deck keys" Text="Each key switches your device to a USER slot that's already saved on it, with WolfEQ open or closed. The lights follow when that's turned on in Lights."/>
                            </StackPanel>
                            <TextBlock Text="Pick a slot, then set up its key." Style="{StaticResource DimText}" Margin="0,4,0,12"/>

                            <!-- One Stream Deck-style key per USER slot; the strip glows in that slot's top-light colour. -->
                            <!-- Five keys per row (5 x 2 for ten slots, like the wizard). The grid shares the panel
                                 width; the negative margin keeps the outer keys flush with the text above. -->
                            <ItemsControl ItemsSource="{Binding StreamDeckKeys}" Margin="-3,0,-3,4">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="StreamDeckKey_Click" Height="70" Margin="3,0,3,6" Cursor="Hand" MinHeight="0" Padding="0"
                                                ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Key" CornerRadius="13" Background="#0C1013" BorderBrush="#2A323A" BorderThickness="1.5">
                                                        <Grid>
                                                            <Border Height="6" CornerRadius="3" Background="{Binding Glow}" Opacity="0.7" VerticalAlignment="Top" Margin="14,7,14,0">
                                                                <Border.Effect><BlurEffect Radius="8"/></Border.Effect>
                                                            </Border>
                                                            <Border Height="3" CornerRadius="2" Background="{Binding Glow}" VerticalAlignment="Top" Margin="16,9,16,0"/>
                                                            <StackPanel VerticalAlignment="Center" Margin="4,8,4,0">
                                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource WolfTextBrush}"/>
                                                                <!-- Local EQ name; hidden when it only repeats the slot ("From USER 1" under "USER 1"). -->
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="62" Foreground="{DynamicResource WolfMutedBrush}" Margin="0,2,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Value="True">
                                                                                    <DataTrigger.Binding>
                                                                                        <MultiBinding Converter="{StaticResource RepeatsText}" ConverterParameter="From ">
                                                                                            <Binding Path="Subtitle"/>
                                                                                            <Binding Path="Label"/>
                                                                                        </MultiBinding>
                                                                                    </DataTrigger.Binding>
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Key" Property="Background" Value="#141A1F"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Key" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                                            <Setter TargetName="Key" Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource SourceTileBorder}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button Style="{StaticResource SettingsPrimaryButton}" Tag="Keyboard" Content="Set up this key" Click="OpenStreamDeckWizard_Click"
                                                DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,6" Margin="10,0,0,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedStreamDeckKey.Label, StringFormat='{}{0} key', FallbackValue='Pick a slot'}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="A short guide, about a minute." Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding StreamDeckSetupNote}" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource SettingsSecondaryButton}" Tag="Folder" Content="Save shortcut..." Command="{Binding SaveStreamDeckShortcutCommand}" Margin="0,0,8,0"
                                                ToolTip="Already know the steps? Save this slot's shortcut straight away."/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Expander Header="Advanced &amp; troubleshooting" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Command for this key" Style="{StaticResource TinyLabel}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding StreamDeckCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Style="{StaticResource SettingsActionButton}" Tag="AppWindow" Content="Copy command" Command="{Binding CopyStreamDeckCommand}" Margin="0,0,8,0"/>
                                </WrapPanel>
                            <ToggleButton x:Name="StreamDeckSetupButton" Style="{StaticResource StudioMenuToggle}" IsChecked="{Binding IsOpen, ElementName=StreamDeckSetupPopup, Mode=TwoWay}" Margin="0,0,0,10" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal"><controls:PhosphorIcon IconName="Keyboard" IconSize="18" IconBrush="{DynamicResource WolfGreenBrush}" Margin="0,0,10,0"/><TextBlock Text="Windows ScriptDeck setup"/></StackPanel>
                            </ToggleButton>
                            <Popup x:Name="StreamDeckSetupPopup" PlacementTarget="{Binding ElementName=StreamDeckSetupButton}" Placement="Left" HorizontalOffset="-10" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Width="420" Padding="18" Background="{DynamicResource WolfPanelBrush}" BorderBrush="{DynamicResource WolfLineSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusOverlay}" PreviewKeyDown="StreamDeckSetup_KeyDown">
                                    <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="&#x00D7;" Style="{StaticResource QuietButton}" Click="CloseStreamDeckSetup_Click" AutomationProperties.Name="Close Stream Deck setup"/><TextBlock Text="One-button EQ switching" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/></DockPanel>
                                            <TextBlock Text="1. Install Windows ScriptDeck" FontWeight="SemiBold"/>
                                            <TextBlock Text="Get the Windows ScriptDeck plugin by Start-Automating from Elgato Marketplace." TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,5,0,8"/>
                                            <Button Content="Open plugin in Marketplace" Command="{Binding OpenWindowsScriptDeckCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="2. Choose the USER slot" FontWeight="SemiBold" Margin="0,16,0,6"/>
                                            <ComboBox ItemsSource="{Binding IntegrationSlots}" SelectedItem="{Binding IntegrationSlot}" AutomationProperties.Name="Stream Deck USER slot"/>
                                            <TextBlock Text="{Binding StreamDeckSetupNote}" TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,6,0,8"/>
                                            <TextBlock Text="3. Paste into On Press" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                            <TextBlock Text="Add the plugin's script action to a Stream Deck key. Copy the script below into its On Press field, then name your key. Repeat with a different slot for each EQ." TextWrapping="Wrap" Style="{StaticResource DimText}"/>
                                            <TextBox Text="{Binding StreamDeckPowerShell, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="0,10,0,8" AutomationProperties.Name="PowerShell script for Windows ScriptDeck"/>
                                            <Button Content="Copy PowerShell script" Command="{Binding CopyStreamDeckPowerShellCommand}" Style="{StaticResource SavePresetButton}"/>
                                            <TextBlock Text="{Binding StreamDeckCopyStatus}" TextWrapping="Wrap" Foreground="{DynamicResource WolfGreenBrush}" Margin="0,6,0,0"/>
                                            <TextBlock Text="Uses your WolfEQ location and saved USB device automatically. Recopy the script if either changes." TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,10,0,0"/>
                                            <TextBlock Text="Switches an EQ already stored on the device. Save or discard editor changes first. For matching LED colors, enable automatic slot lighting and save a Bluetooth connection." TextWrapping="Wrap" Style="{StaticResource DimText}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4" Text="Shortcut method: in Stream Deck, drag System > Open onto a key and pick the saved .lnk in App / File. Works with WolfEQ open or closed. Recreate shortcuts if you move WolfEQ or change the USB device."/>
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4" Text="Keys never overwrite a slot with a library preset. Save or discard unsaved editor changes before pressing one."/>
                                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4" Text="Troubleshooting: the latest result is in %LOCALAPPDATA%\WolfEQ\automation-result.json. For scripts: --help and --list-devices. Exit codes: 0 success, 1 failure, 2 invalid arguments, 3 busy or unsaved edits, 4 slot switched but lighting failed."/>
                            </StackPanel></Expander>
                        </StackPanel>

                        <!-- Software EQ mode: bypass and library-preset commands for Stream Deck keys and scripts.
                             Templated in only in Software EQ mode so hardware mode keeps a single command box. -->
                        <ContentControl x:Name="SystemEqShortcutsPanel" Content="{Binding}" Focusable="False"
                                        Visibility="{Binding IsSystemEqSelected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemEqSelected}" Value="True">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource SourceTileBorder}">
                                                            <StackPanel>
                                                                <TextBlock Text="Stream Deck and shortcuts" Style="{StaticResource CardTitle}"/>
                                                                <TextBlock Text="Bypass Software EQ or apply a library preset from a Stream Deck key, shortcut or script. WolfEQ can be open or closed." Style="{StaticResource Caption}" Margin="0,6,0,10"/>
                                                                <TextBlock Text="Bypass (on, off or toggle)" FontWeight="SemiBold"/>
                                                                <TextBox Text="{Binding StreamDeckExecutable, Mode=OneWay, StringFormat='&quot;{0}&quot; --system-eq-bypass toggle', FallbackValue='WolfEQ.exe --system-eq-bypass toggle'}"
                                                                         IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,4,0,10"
                                                                         AutomationProperties.Name="Software EQ bypass command"/>
                                                                <TextBlock Text="Apply a library preset" FontWeight="SemiBold"/>
                                                                <TextBox Text="{Binding StreamDeckExecutable, Mode=OneWay, StringFormat='&quot;{0}&quot; --preset &quot;Ananda Music - Warm Detail&quot;', FallbackValue='WolfEQ.exe --preset &quot;Ananda Music - Warm Detail&quot;'}"
                                                                         IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,4,0,8"
                                                                         AutomationProperties.Name="Apply preset command"/>
                                                                <TextBlock Text="Use the preset name exactly as it appears in your library. In Stream Deck, drag System &gt; Open onto a key and use a shortcut with these arguments, or paste the command into a script action." Style="{StaticResource DimText}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="The latest command result is in %LOCALAPPDATA%\WolfEQ\automation-result.json." Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Look" Tag="Palette" views:SettingsPopover.SectionColor="{StaticResource SectionLookBrush}" views:SettingsPopover.SectionSummary="{Binding AppearanceSectionSummary}" HeaderTemplate="{StaticResource SettingsSectionHeader}"
                              IsExpanded="False"
                              Foreground="{DynamicResource WolfMutedBrush}"
                              Margin="0,0,0,8">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Background" Style="{StaticResource TinyLabel}" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding BackgroundModes}" SelectedItem="{Binding SelectedBackgroundMode}" AutomationProperties.Name="Background mode" Margin="0,0,0,16"/>
                            <TextBlock Text="Accent theme"
                                       Style="{StaticResource TinyLabel}"
                                       Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AccentColorOptions}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="AccentColorSwatch_Click"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,8,8"
                                                Padding="0"
                                                Cursor="Hand"
                                                ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                Background="Transparent"
                                                BorderBrush="Transparent">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Grid Width="44" Height="44">
                                                        <Border x:Name="SelectionRing"
                                                                Width="42"
                                                                Height="42"
                                                                CornerRadius="21"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                        <Border x:Name="Dot"
                                                                Width="34"
                                                                Height="34"
                                                                CornerRadius="17"
                                                                Background="{Binding Brush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Dot" Property="Opacity" Value="0.82"/>
                                                        </Trigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource ReferenceEqualsMultiConverter}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.SelectedAccentColorOption"
                                                                             RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource WolfTextBrush}"/>
                                                            <Setter TargetName="SelectionRing" Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SelectedAccentColorOption.Name}" FontWeight="SemiBold" Foreground="{DynamicResource WolfGreenBrush}"/>
                            <TextBlock Text="{Binding SelectedAccentColorOption.Description}" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="About" Tag="AppWindow" views:SettingsPopover.SectionColor="{StaticResource SectionAboutBrush}" views:SettingsPopover.SectionSummary="{Binding AboutSectionSummary}" HeaderTemplate="{StaticResource SettingsSectionHeader}"
                              IsExpanded="False"
                              Foreground="{DynamicResource WolfMutedBrush}">
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="WolfEQ" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding AppVersionText}"
                                               Style="{StaticResource DimText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <!-- Both update actions side by side, next to the version they relate to. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SettingsActionButton}" Tag="ArrowRight" Content="Releases"
                                            Command="{Binding OpenReleasesCommand}" Margin="0,0,6,0"
                                            ToolTip="See what's new in each version"/>
                                    <Button Style="{StaticResource SettingsActionButton}" Tag="Cloud"
                                            Content="Check for updates"
                                            Command="{Binding CheckForUpdatesCommand}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding UpdateStatus}"
                                       Style="{StaticResource DimText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Button x:Name="DiscordChannelButton" Command="{Binding OpenDiscordCommand}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,0,10" ToolTip="Open the WolfEQ app channel in Discord" AutomationProperties.Name="Open WolfEQ Discord channel">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource WolfAccentHoverBrush}" CornerRadius="{StaticResource RadiusControl}" Margin="0,0,12,0">
                                        <Path Data="{StaticResource DiscordLogoGeometry}" Fill="{DynamicResource WolfGreenBrush}" Width="26" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="WolfEQ on Discord" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Open our app channel" Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Path Grid.Column="2" Data="M2,12 L12,2 M4,2 H12 V10" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding OpenBuyMeCoffeeCommand}"
                                    Style="{StaticResource QuietButton}"
                                    HorizontalAlignment="Left"
                                    ToolTip="buymeacoffee.com/audioslayer">
                                <StackPanel Orientation="Horizontal">
                                    <controls:PhosphorIcon IconName="Heart"
                                                           IconSize="15"
                                                           IconBrush="{DynamicResource WolfMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="Buy me a coffee"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
