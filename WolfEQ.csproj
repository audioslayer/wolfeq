<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icon\wolfeq.ico</ApplicationIcon>
    <AssemblyName>WolfEQ</AssemblyName>
    <RootNamespace>WolfEQ</RootNamespace>
    <Version>0.8.0-beta</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>
    <!-- Pinned Equalizer APO installer (KTD14). Keep in sync with build-installer.bat and
         ApoProcessLauncher.PinnedInstallerFileName; a test checks all three agree. -->
    <EqualizerApoInstallerFileName>EqualizerAPO-x64-1.4.2.exe</EqualizerApoInstallerFileName>
    <!-- Keep repository build artifacts excluded even when deploy.bat redirects obj/bin locally. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <EmbeddedResource Remove="tools\**\*" />
    <None Remove="tools\**\*" />
    <Page Remove="tools\**\*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Page Remove="tests\**\*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Update="LICENSE;THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\icon\wolfeq.png" />
    <Resource Include="Assets\icon\wolfeq.ico" />
    <Resource Include="Assets\devices\*.png" />
    <None Include="Assets\icon\wolfeq-source.png" />
    <!-- Equalizer APO installer bundled for Windows System EQ. The exe is gitignored and is
         downloaded and hash-checked by build-installer.bat. Only the exact pinned file is bundled
         (it is run elevated); the name must match ApoProcessLauncher.PinnedInstallerFileName. -->
    <None Include="redist\EqualizerAPO\$(EqualizerApoInstallerFileName)"
          Condition="Exists('redist\EqualizerAPO\$(EqualizerApoInstallerFileName)')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
