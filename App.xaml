<Application x:Class="WolfEQ.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="WolfBg">#0F0F0F</Color>
        <Color x:Key="WolfShell">#141414</Color>
        <Color x:Key="WolfPanel">#1C1C1C</Color>
        <Color x:Key="WolfPanel2">#242424</Color>
        <Color x:Key="WolfLine">#2A2A2A</Color>
        <Color x:Key="WolfLineSoft">#363636</Color>
        <Color x:Key="WolfCyan">#06B6D4</Color>
        <Color x:Key="WolfCyanDim">#12323A</Color>
        <Color x:Key="WolfFiioRed">#C8102E</Color>
        <Color x:Key="WolfFiioRedDim">#331017</Color>
        <Color x:Key="WolfGreen">#00E676</Color>
        <Color x:Key="WolfGreenContrast">#06130B</Color>
        <Color x:Key="WolfWarning">#FFB800</Color>
        <Color x:Key="WolfDanger">#FF5555</Color>
        <Color x:Key="WolfText">#E8E8E8</Color>
        <Color x:Key="WolfMuted">#B0B0B0</Color>
        <Color x:Key="WolfDim">#7E7E7E</Color>
        <Color x:Key="WolfAccentHover">#1A00E676</Color>

        <SolidColorBrush x:Key="WolfBgBrush" Color="{StaticResource WolfBg}"/>
        <SolidColorBrush x:Key="WolfShellBrush" Color="{StaticResource WolfShell}"/>
        <SolidColorBrush x:Key="WolfPanelBrush" Color="{StaticResource WolfPanel}"/>
        <SolidColorBrush x:Key="WolfPanel2Brush" Color="{StaticResource WolfPanel2}"/>
        <SolidColorBrush x:Key="WolfLineBrush" Color="{StaticResource WolfLine}"/>
        <SolidColorBrush x:Key="WolfLineSoftBrush" Color="{StaticResource WolfLineSoft}"/>
        <SolidColorBrush x:Key="WolfCyanBrush" Color="{StaticResource WolfCyan}"/>
        <SolidColorBrush x:Key="WolfCyanDimBrush" Color="{StaticResource WolfCyanDim}"/>
        <SolidColorBrush x:Key="WolfFiioRedBrush" Color="{StaticResource WolfFiioRed}"/>
        <SolidColorBrush x:Key="WolfFiioRedDimBrush" Color="{StaticResource WolfFiioRedDim}"/>
        <SolidColorBrush x:Key="WolfGreenBrush" Color="{StaticResource WolfGreen}"/>
        <SolidColorBrush x:Key="WolfGreenContrastBrush" Color="{StaticResource WolfGreenContrast}"/>
        <SolidColorBrush x:Key="WolfWarningBrush" Color="{StaticResource WolfWarning}"/>
        <SolidColorBrush x:Key="WolfDangerBrush" Color="{StaticResource WolfDanger}"/>
        <SolidColorBrush x:Key="WolfTextBrush" Color="{StaticResource WolfText}"/>
        <SolidColorBrush x:Key="WolfMutedBrush" Color="{StaticResource WolfMuted}"/>
        <SolidColorBrush x:Key="WolfDimBrush" Color="{StaticResource WolfDim}"/>
        <SolidColorBrush x:Key="WolfAccentHoverBrush" Color="{StaticResource WolfAccentHover}"/>

        <DropShadowEffect x:Key="WolfComboShadow"
                          Color="Black"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.5"
                          Direction="270"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="Background" Value="{StaticResource WolfBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource WolfMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource WolfDimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource WolfDimBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WolfPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="OverlayPanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#FC181A1C"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="CornerRadius" Value="12,0,0,12"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="InsetBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WolfShellBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="BandPowerToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Track"
                                Background="#0A0A0A"
                                BorderBrush="{StaticResource WolfLineSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Border x:Name="Thumb"
                                    Width="12"
                                    Height="12"
                                    Margin="4,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource WolfDimBrush}"
                                    CornerRadius="3"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/>
                                <Setter TargetName="Thumb" Property="Background" Value="{StaticResource WolfGreenBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource WolfCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceTileBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WolfCyanBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfCyanDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource WolfCyanDimBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfCyanBrush}"/>
        </Style>

        <Style x:Key="SavePresetButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource WolfMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#163F2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#00A85D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfileLibraryDirty}" Value="True">
                    <Setter Property="Background" Value="#00C767"/>
                    <Setter Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/>
                    <Setter Property="Foreground" Value="#06130B"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SaveNeedsAttentionStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                               Duration="0:0:2.4">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.06" Value="-2"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="2"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="-1.25"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1.25"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="-0.5"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SaveNeedsAttentionStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="{StaticResource WolfWarningBrush}"/>
        </Style>

        <Style x:Key="FiioButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource WolfShellBrush}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <Style x:Key="OverlayCloseButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource WolfMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfCyanDimBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderNavToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource WolfMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ActiveRail"
                                    Height="2"
                                    Margin="10,0,10,2"
                                    Background="{DynamicResource WolfGreenBrush}"
                                    CornerRadius="1"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="ActiveRail" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderHistoryButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource WolfMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacWindowChromeButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#66000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Circle"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="0.8"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Stroke" Value="#55000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#5A1818"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacWindowCloseButton" TargetType="Button" BasedOn="{StaticResource MacWindowChromeButton}">
            <Setter Property="Background" Value="#FF5F57"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="MacWindowMinimizeButton" TargetType="Button" BasedOn="{StaticResource MacWindowChromeButton}">
            <Setter Property="Background" Value="#FFBD2E"/>
        </Style>

        <Style x:Key="MacWindowMaximizeButton" TargetType="Button" BasedOn="{StaticResource MacWindowChromeButton}">
            <Setter Property="Background" Value="#28C840"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource WolfCyanBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{StaticResource WolfCyanDimBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#FF202427"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BandValueTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource WolfCyanBrush}"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <ControlTemplate x:Key="DarkComboToggle" TargetType="{x:Type ToggleButton}">
            <Border x:Name="Border"
                    CornerRadius="7"
                    Background="{StaticResource WolfPanel2Brush}"
                    BorderBrush="{StaticResource WolfLineSoftBrush}"
                    BorderThickness="1"
                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1">
                        <Path x:Name="Arrow"
                              Data="M 0,0 L 5,5 L 10,0"
                              Stroke="{StaticResource WolfTextBrush}"
                              StrokeThickness="1.5"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/>
                    <Setter TargetName="Border" Property="Background" Value="#FF202427"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource WolfGreenBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource WolfGreenBrush}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource WolfGreenBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="HoverComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboToggle}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                               Margin="11,6,32,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        CornerRadius="10"
                                        Background="#FC181A1C"
                                        BorderBrush="{StaticResource WolfLineSoftBrush}"
                                        BorderThickness="1"
                                        Margin="0,6,0,0"
                                        Padding="4"
                                        Effect="{StaticResource WolfComboShadow}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource HoverComboBox}"/>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Grid Margin="1">
                            <Border x:Name="Bd"
                                    CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="SelectedRail"
                                    Width="2"
                                    Height="16"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource WolfGreenBrush}"
                                    CornerRadius="1"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WolfLineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WolfLineBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource WolfGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="SelectedRail" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource WolfGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource WolfCyanBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource WolfCyanBrush}"/>
            <Setter Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource WolfMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Background="{StaticResource WolfPanel2Brush}"
                                    BorderBrush="{StaticResource WolfLineSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Width="10"
                                      Height="8"
                                      Data="M 1,4 L 4,7 L 9,1"
                                      Stroke="{StaticResource WolfGreenContrastBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="7,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#FC181A1C"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource WolfShellBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WolfPanelBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WolfLineSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{StaticResource WolfMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border x:Name="Frame"
                                Background="{StaticResource WolfShellBrush}"
                                BorderBrush="{StaticResource WolfLineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              Padding="12,10"
                                              HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="HeaderChrome"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="9"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                    <Path x:Name="Arrow"
                                                          Grid.Column="1"
                                                          Data="M 1,1 L 5,5 L 1,9"
                                                          Stroke="{TemplateBinding Foreground}"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="6"
                                                          Height="10"
                                                          Stretch="Uniform"
                                                          Margin="12,0,2,0"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource WolfCyanBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="#FF172126"/>
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 1,2 L 5,6 L 9,2"/>
                                                    <Setter TargetName="Arrow" Property="Width" Value="10"/>
                                                    <Setter TargetName="Arrow" Property="Height" Value="6"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>
                                <Border x:Name="ExpandSite"
                                        Visibility="Collapsed"
                                        BorderBrush="{StaticResource WolfLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,2,12,12">
                                    <ContentPresenter ContentSource="Content"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FF3E484C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource WolfShellBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource WolfLineBrush}"/>
            <Setter Property="RowBackground" Value="#161616"/>
            <Setter Property="AlternatingRowBackground" Value="#1A1A1A"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource WolfPanel2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource WolfMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WolfLineBrush}"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="WolfScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="{StaticResource WolfCyanDimBrush}"
                                CornerRadius="3"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource WolfGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="Transparent" CornerRadius="4">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource WolfScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="Transparent" CornerRadius="4">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource WolfScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="PanningMode" Value="Both"/>
        </Style>

    </Application.Resources>
</Application>
