<Application x:Class="WolfEQ.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Color x:Key="WolfBg">#0C1419</Color>
        <Color x:Key="WolfShell">#101B21</Color>
        <Color x:Key="WolfPanel">#111C22</Color>
        <Color x:Key="WolfPanel2">#17242C</Color>
        <Color x:Key="WolfLine">#253740</Color>
        <Color x:Key="WolfLineSoft">#334752</Color>
        <Color x:Key="WolfCyan">#00E676</Color>
        <Color x:Key="WolfCyanDim">#00964D</Color>
        <Color x:Key="WolfFiioRed">#C8102E</Color>
        <Color x:Key="WolfFiioRedDim">#331017</Color>
        <Color x:Key="WolfGreen">#00E676</Color>
        <Color x:Key="WolfGreenContrast">#000000</Color>
        <Color x:Key="WolfWarning">#FFB800</Color>
        <Color x:Key="WolfDanger">#FF5555</Color>
        <Color x:Key="WolfText">#F0F5F7</Color>
        <Color x:Key="WolfMuted">#A7BDC9</Color>
        <Color x:Key="WolfDim">#90A8B6</Color>
        <Color x:Key="WolfAccentHover">#1A00E676</Color>

        <SolidColorBrush x:Key="WolfBgBrush" Color="{DynamicResource WolfBg}"/>
        <SolidColorBrush x:Key="WolfShellBrush" Color="{DynamicResource WolfShell}"/>
        <SolidColorBrush x:Key="WolfPanelBrush" Color="{DynamicResource WolfPanel}"/>
        <SolidColorBrush x:Key="WolfPanel2Brush" Color="{DynamicResource WolfPanel2}"/>
        <SolidColorBrush x:Key="WolfLineBrush" Color="{DynamicResource WolfLine}"/>
        <SolidColorBrush x:Key="WolfLineSoftBrush" Color="{DynamicResource WolfLineSoft}"/>
        <SolidColorBrush x:Key="WolfCyanBrush" Color="{DynamicResource WolfCyan}"/>
        <SolidColorBrush x:Key="WolfCyanDimBrush" Color="{DynamicResource WolfCyanDim}"/>
        <SolidColorBrush x:Key="WolfFiioRedBrush" Color="{StaticResource WolfFiioRed}"/>
        <SolidColorBrush x:Key="WolfFiioRedDimBrush" Color="{StaticResource WolfFiioRedDim}"/>
        <SolidColorBrush x:Key="WolfGreenBrush" Color="{DynamicResource WolfGreen}"/>
        <SolidColorBrush x:Key="WolfGreenContrastBrush" Color="{DynamicResource WolfGreenContrast}"/>
        <SolidColorBrush x:Key="WolfWarningBrush" Color="{DynamicResource WolfWarning}"/>
        <SolidColorBrush x:Key="WolfDangerBrush" Color="{DynamicResource WolfDanger}"/>
        <SolidColorBrush x:Key="WolfTextBrush" Color="{DynamicResource WolfText}"/>
        <SolidColorBrush x:Key="WolfMutedBrush" Color="{DynamicResource WolfMuted}"/>
        <SolidColorBrush x:Key="WolfDimBrush" Color="{DynamicResource WolfDim}"/>
        <SolidColorBrush x:Key="WolfAccentHoverBrush" Color="{DynamicResource WolfAccentHover}"/>

        <DropShadowEffect x:Key="WolfComboShadow"
                          Color="Black"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.5"
                          Direction="270"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource WolfBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfDimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfDimBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WolfPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="OverlayPanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WolfPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="CornerRadius" Value="12,0,0,12"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="InsetBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WolfShellBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="BandPowerToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Track"
                                Background="{DynamicResource WolfPanel2Brush}"
                                BorderBrush="{DynamicResource WolfLineSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Border x:Name="Thumb"
                                    Width="16"
                                    Height="16"
                                    Margin="2,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource WolfDimBrush}"
                                    CornerRadius="8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource WolfTextBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceTileBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                <Border x:Name="Glow" Margin="-3" CornerRadius="9" BorderThickness="4" BorderBrush="{DynamicResource WolfGreenBrush}" Opacity="0.12" Visibility="Collapsed" IsHitTestVisible="False"/>
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/><Setter TargetName="Glow" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/><Setter TargetName="Glow" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Glow" Property="Visibility" Value="Collapsed"/><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource WolfCyanDimBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
        </Style>

        <Style x:Key="SavePresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource WolfGreenBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfGreenContrastBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="{DynamicResource WolfWarningBrush}"/>
        </Style>

        <Style x:Key="FiioButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <Style x:Key="OverlayCloseButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="StudioTabs" TargetType="TabControl">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel>
                <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,12"/>
                <ContentPresenter ContentSource="SelectedContent"/>
            </DockPanel></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StudioTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="Rail" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,12,0">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/><Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Rail" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StudioMenuToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource WolfPanel2Brush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderNavToggle" TargetType="ToggleButton" BasedOn="{StaticResource StudioMenuToggle}"/>

        <Style x:Key="HeaderHistoryButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.28"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Amp Up traffic lights: 14px circles with 8px between them. -->
        <Style x:Key="MacWindowChromeButton" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Dot" Width="14" Height="14" Fill="{TemplateBinding Background}"/>
                            <TextBlock x:Name="Symbol" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                <Setter TargetName="Symbol" Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Symbol" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacWindowCloseButton" TargetType="Button" BasedOn="{StaticResource MacWindowChromeButton}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0,-1,0,0"/>
            <Setter Property="Background" Value="#FF5F56"/>
            <Setter Property="Foreground" Value="#990F04"/>
        </Style>
        <Style x:Key="MacWindowMinimizeButton" TargetType="Button" BasedOn="{StaticResource MacWindowChromeButton}">
            <Setter Property="Padding" Value="0,-2,0,0"/>
            <Setter Property="Background" Value="#FFBD2E"/>
            <Setter Property="Foreground" Value="#995700"/>
        </Style>
        <Style x:Key="MacWindowMaximizeButton" TargetType="Button" BasedOn="{StaticResource MacWindowChromeButton}">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="0,-1,0,0"/>
            <Setter Property="Background" Value="#27C93F"/>
            <Setter Property="Foreground" Value="#0A6C15"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource WolfCyanBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource WolfCyanDimBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BandValueTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource WolfCyanBrush}"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <ControlTemplate x:Key="DarkComboToggle" TargetType="{x:Type ToggleButton}">
            <Border x:Name="Border"
                    CornerRadius="7"
                    Background="{DynamicResource WolfPanel2Brush}"
                    BorderBrush="{DynamicResource WolfLineSoftBrush}"
                    BorderThickness="1"
                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1">
                        <Path x:Name="Arrow"
                              Data="M 0,0 L 5,5 L 10,0"
                              Stroke="{DynamicResource WolfTextBrush}"
                              StrokeThickness="1.5"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource WolfGreenBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource WolfGreenBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="HoverComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboToggle}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                               Margin="11,6,32,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        CornerRadius="6"
                                        Background="{DynamicResource WolfPanelBrush}"
                                        BorderBrush="{DynamicResource WolfLineSoftBrush}"
                                        BorderThickness="1"
                                        Margin="0,6,0,0"
                                        Padding="4"
                                        Effect="{StaticResource WolfComboShadow}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource HoverComboBox}"/>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Grid Margin="1">
                            <Border x:Name="Bd"
                                    CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="SelectedRail"
                                    Width="2"
                                    Height="16"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource WolfGreenBrush}"
                                    CornerRadius="1"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WolfLineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WolfLineBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="SelectedRail" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource WolfCyanBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource WolfCyanBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Background="{DynamicResource WolfPanel2Brush}"
                                    BorderBrush="{DynamicResource WolfLineSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Width="10"
                                      Height="8"
                                      Data="M 1,4 L 4,7 L 9,1"
                                      Stroke="{DynamicResource WolfGreenContrastBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="7,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource WolfPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource WolfShellBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfPanelBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfLineSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WolfAccentHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource WolfGreenBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border x:Name="Frame"
                                Background="{DynamicResource WolfShellBrush}"
                                BorderBrush="{DynamicResource WolfLineBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderSite"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              Padding="12,10"
                                              HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="HeaderChrome"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                    <Path x:Name="Arrow"
                                                          Grid.Column="1"
                                                          Data="M 1,1 L 5,5 L 1,9"
                                                          Stroke="{TemplateBinding Foreground}"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="6"
                                                          Height="10"
                                                          Stretch="Uniform"
                                                          Margin="12,0,2,0"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource WolfCyanBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 1,2 L 5,6 L 9,2"/>
                                                    <Setter TargetName="Arrow" Property="Width" Value="10"/>
                                                    <Setter TargetName="Arrow" Property="Height" Value="6"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource WolfGreenBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>
                                <Border x:Name="ExpandSite" Grid.Row="1"
                                        Visibility="Collapsed"
                                        BorderBrush="{DynamicResource WolfLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,2,12,12">
                                    <ContentPresenter ContentSource="Content"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource WolfShellBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource WolfLineBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource WolfPanelBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource WolfPanel2Brush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource WolfPanel2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WolfLineBrush}"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="WolfScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="{DynamicResource WolfCyanDimBrush}"
                                CornerRadius="3"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource WolfCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource WolfGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="Transparent" CornerRadius="4">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource WolfScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Border Background="Transparent" CornerRadius="4">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource WolfScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="PanningMode" Value="Both"/>
        </Style>

        <Style x:Key="StudioBypass" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WolfMutedBrush}"/><Setter Property="Content" Value="Bypass"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="4"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border Padding="{TemplateBinding Padding}" Background="Transparent"><StackPanel Orientation="Horizontal">
                    <Grid Width="16" Height="16" Margin="0,0,9,0"><Ellipse x:Name="Ring" Stroke="{DynamicResource WolfDimBrush}" StrokeThickness="2"/><Ellipse x:Name="Dot" Fill="{DynamicResource WolfGreenBrush}" Margin="4" Visibility="Collapsed"/></Grid>
                    <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel></Border><ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource WolfGreenBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource WolfTextBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>
