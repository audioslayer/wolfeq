<Window x:Class="WolfEQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:WolfEQ.Controls"
        xmlns:views="clr-namespace:WolfEQ.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="WolfEQ"
        Icon="Assets/icon/wolfeq.ico"
        Width="1586"
        Height="992"
        MinWidth="1280"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WolfBgBrush}"
        Foreground="{DynamicResource WolfTextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource WolfBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource WolfLineBrush}" BorderThickness="0,0,0,1" Background="Transparent">
            <DockPanel Margin="22,0,12,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M0,18 L5,18 L9,7 L13,30 L18,0 L23,36 L28,12 L32,23 L37,18" Stroke="{DynamicResource WolfGreenBrush}" StrokeThickness="3" StrokeLineJoin="Round" Width="36" Height="34" Stretch="Uniform" Margin="0,0,18,0"/>
                    <TextBlock FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="Wolf"/><Run Text="EQ" Foreground="{DynamicResource WolfGreenBrush}"/></TextBlock>
                    <Border Width="1" Height="28" Background="{DynamicResource WolfLineSoftBrush}" Margin="24,0"/>
                    <Button x:Name="UndoHeaderButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="UndoHeaderButton_Click" IsEnabled="{Binding CanUndo}" Style="{StaticResource QuietButton}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><Path Data="M7,0 L1,6 L7,12 M1,6 H12 C23,6 23,19 12,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="22" Height="20"/></Button>
                    <Button x:Name="RedoHeaderButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="RedoHeaderButton_Click" IsEnabled="{Binding CanRedo}" Style="{StaticResource QuietButton}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><Path Data="M15,0 L21,6 L15,12 M21,6 H10 C-1,6 -1,19 10,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="22" Height="20"/></Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="LibraryHeaderButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource HeaderNavToggle}" Click="LibraryHeaderButton_Click"><StackPanel Orientation="Horizontal"><Path Data="M1,2 L9,1 L11,3 L13,1 L21,2 V19 L13,18 L11,20 L9,18 L1,19 Z M11,3 V20 M4,6 H7 M15,6 H18 M4,10 H7 M15,10 H18" Stroke="{DynamicResource WolfTextBrush}" StrokeThickness="1.4" Width="22" Height="22" Margin="0,0,10,0"/><TextBlock Text="Library"/></StackPanel></ToggleButton>
                    <ToggleButton x:Name="SettingsHeaderButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource HeaderNavToggle}" Click="SettingsHeaderButton_Click"><StackPanel Orientation="Horizontal"><controls:PhosphorIcon IconName="Gear" IconSize="22" Margin="0,0,10,0"/><TextBlock Text="Settings"/></StackPanel></ToggleButton>
                    <StackPanel x:Name="WindowControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="&#x2014;" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" Style="{StaticResource MacWindowMinimizeButton}" Click="MinimizeWindow_Click" ToolTip="Minimize"/>
                    <Button Content="&#x2922;" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize or restore" Style="{StaticResource MacWindowMaximizeButton}" Click="MaximizeRestoreWindow_Click" ToolTip="Maximize / Restore"/>
                    <Button Content="&#x2715;" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close" Style="{StaticResource MacWindowCloseButton}" Click="CloseWindow_Click" ToolTip="Close"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Permanent device dock strip. -->
        <views:DeviceDock x:Name="DeviceToolbar" Grid.Row="1" Margin="22,16,22,0"/>

        <!-- The editor workspace fills the rest of the window. -->
        <views:EditorWorkspace Grid.Row="2" Margin="22,16,22,16"/>

        <!-- Overlay layer: right slide-overs for Library and Settings over a dim scrim. -->
        <Grid x:Name="OverlayLayer"
              Grid.Row="1"
              Grid.RowSpan="2"
              Panel.ZIndex="100"
              Visibility="Collapsed">
            <Border x:Name="OverlayDimmer"
                    Background="#B3000000"
                    Opacity="0"
                    MouseLeftButtonDown="OverlayDimmer_MouseLeftButtonDown"/>
            <views:LibraryPanel x:Name="LibraryHost"
                                HorizontalAlignment="Right"
                                Margin="0"
                                Visibility="Collapsed">
                <views:LibraryPanel.RenderTransform>
                    <TranslateTransform X="880"/>
                </views:LibraryPanel.RenderTransform>
            </views:LibraryPanel>
            <views:SettingsPopover x:Name="SettingsHost"
                                   HorizontalAlignment="Right"
                                   Margin="0"
                                   Visibility="Collapsed">
                <views:SettingsPopover.RenderTransform>
                    <TranslateTransform X="492"/>
                </views:SettingsPopover.RenderTransform>
            </views:SettingsPopover>
        </Grid>
    </Grid>
</Window>
